Von oben'\r\n};\r\n\r\nObject.assign(DE_DICT._textMap, {\r\n  \"自动化任务\": \"Automatisieren Sie Aufgaben\",\r\n  \"自动化任务编辑器\": \"Editor für Automatisierungsaufgaben\",\r\n  \"运行\": \"laufen\",\r\n  \"未保存\": \"nicht gespeichert\",\r\n  \"立即运行一次\": \"Jetzt einmal ausführen\",\r\n  \"测试\": \"prüfen\",\r\n  \"任务\": \"Aufgabe\",\r\n  \"触发器\": \"auslösen\",\r\n  \"类型\": \"Typ\",\r\n  \"测试渲染提示词\": \"Testen Sie die Wiedergabe von Aufforderungswörtern\",\r\n  \"例如：构建通知\": \"Beispiel: Build-Benachrichtigung\",\r\n  \"投递\": \"Lieferung\",\r\n  \"HTTP 信号服务器\": \"HTTP-Signalserver\",\r\n  \"定时（cron）\": \"Timing (cron)\",\r\n  \"继续当前 Chat（无则新建）\": \"Setzen Sie den aktuellen Chat fort (erstellen Sie einen neuen, falls noch keiner vorhanden ist)\",\r\n  \"提示词送到哪里\": \"Wohin soll die Aufforderung gesendet werden?\",\r\n  \"新建 Chat 会话\": \"Erstellen Sie eine neue Chat-Sitzung\",\r\n  \"统计\": \"Statistiken\",\r\n  \"继续模式：优先当前激活的 Chat，其次最近一个空闲且有内容的会话；对方正在运行时自动排队。\": \"Fortsetzungsmodus: Priorisiert den aktuell aktiven Chat, gefolgt von der letzten inaktiven Sitzung mit Inhalt; automatisch in die Warteschlange gestellt, wenn die andere Partei aktiv ist.\",\r\n  \"任务 ID\": \"Aufgaben-ID\",\r\n  \"运行次数\": \"Anzahl der Läufe\",\r\n  \"上次运行\": \"letzter Lauf\",\r\n  \"复制任务 ID\": \"Aufgaben-ID kopieren\",\r\n  \"文档\": \"dokumentieren\",\r\n  \"HTTP 信号接口\": \"HTTP-Signalschnittstelle\",\r\n  \"自动化与 DSL 文档\": \"Automatisierung und DSL-Dokumentation\",\r\n  \"Ctrl/Cmd+S 保存 · Ctrl/Cmd+Enter 测试\": \"Strg/Befehl+S Speichern · Strg/Befehl+Eingabe Test\",\r\n  \"输出\": \"Ausgabe\",\r\n  \"自适应视图\": \"adaptive Sicht\",\r\n  \"未命名工程\": \"Unbenanntes Projekt\",\r\n  \"语法有效\": \"Die Syntax ist gültig\",\r\n  \"保存工程\": \"Projekt speichern\",\r\n  \"导入DXF文件\": \"DXF-Dateien importieren\",\r\n  \"导出PNG\": \"PNG exportieren\",\r\n  \"保存提示\": \"Sparen Sie Tipps\",\r\n  \"最大化/还原\": \"Maximieren/Wiederherstellen\",\r\n  \"导出DXF\": \"DXF exportieren\",\r\n  \"图层\": \"Schichten\",\r\n  \"是否保存对当前工程的修改？\": \"Möchten Sie Änderungen am aktuellen Projekt speichern?\",\r\n  \"不保存\": \"Sparen Sie nicht\",\r\n  \"删除图层\": \"Ebene löschen\",\r\n  \"新建图层\": \"Neue Ebene erstellen\",\r\n  \"全选\": \"Alles auswählen\",\r\n  \"清除选择\": \"Klare Auswahl\",\r\n  \"直线\": \"Gerade\",\r\n  \"置为当前\": \"Als aktuell festlegen\",\r\n  \"多段线\": \"Polylinie\",\r\n  \"0 个对象\": \"0 Objekte\",\r\n  \"矩形\": \"Rechteck\",\r\n  \"圆\": \"runden\",\r\n  \"圆弧\": \"Bogen\",\r\n  \"文本\": \"Text\",\r\n  \"椭圆\": \"Oval\",\r\n  \"标注\": \"markieren\",\r\n  \"填充\": \"Füllung\",\r\n  \"移动\": \"bewegen\",\r\n  \"旋转\": \"drehen\",\r\n  \"缩放\": \"Zoom\",\r\n  \"镜像\": \"Spiegel\",\r\n  \"当前:\": \"aktuell:\",\r\n  \"清空图纸\": \"Klare Zeichnung\",\r\n  \"就绪\": \"bereit\",\r\n  \"选中\": \"ausgewählt\",\r\n  \"清空\": \"Klar\",\r\n  \"命令:\": \"Befehl:\",\r\n  \"删除选中\": \"Ausgewählte entfernen\",\r\n  \"命令控制台\": \"Befehlskonsole\",\r\n  \"输入命令 (如 line 0,0 100,100) 后回车执行\": \"Geben Sie den Befehl ein (z. B. Zeile 0,0 100,100) und drücken Sie zur Ausführung die Eingabetaste\",\r\n  \"运行诊断\": \"Führen Sie eine Diagnose durch\",\r\n  \"运行诊断 · CIBYP\": \"Führen Sie die Diagnose · CIBYP aus\",\r\n  \"关闭诊断窗口\": \"Diagnosefenster schließen\",\r\n  \"上次运行意外中断\": \"Der letzte Lauf wurde unerwartet unterbrochen\",\r\n  \"异常退出记录\": \"Ausnahme-Exit-Datensatz\",\r\n  \"正在读取诊断信息…\": \"Diagnoseinformationen werden gelesen...\",\r\n  \"读取中…\": \"Lektüre…\",\r\n  \"异常摘要\": \"Zusammenfassung der Ausnahmen\",\r\n  \"最近异常\": \"Jüngste Anomalie\",\r\n  \"被中断会话\": \"Unterbrochene Sitzung\",\r\n  \"异常时间\": \"ungewöhnliche Zeit\",\r\n  \"诊断详情\": \"Diagnosedetails\",\r\n  \"应用版本\": \"Anwendungsversion\",\r\n  \"按需展开\": \"Erweitern Sie nach Bedarf\",\r\n  \"技术诊断信息\": \"Technische Diagnoseinformationen\",\r\n  \"末尾 300 行\": \"Letzte 300 Zeilen\",\r\n  \"异常记录\": \"Ausnahmedatensätze\",\r\n  \"最近日志\": \"Aktuelle Protokolle\",\r\n  \"打开日志目录 ↗\": \"Öffnen Sie das Protokollverzeichnis ↗\",\r\n  \"环境与转储\": \"Umwelt und Mülldeponie\",\r\n  \"0 个转储文件\": \"0 Dump-Dateien\",\r\n  \"打开转储目录 ↗\": \"Öffnen Sie das Dump-Verzeichnis ↗\",\r\n  \"原生转储文件\": \"native Dump-Datei\",\r\n  \"高级操作\": \"Erweiterte Operationen\",\r\n  \"记录本次运行的内存状态，供排查使用。生成时应用可能短暂暂停。\": \"Notieren Sie den Speicherstatus dieses Laufs zur Fehlerbehebung. Die Anwendung kann während der Erstellung kurz pausieren.\",\r\n  \"当前内存快照\": \"Aktueller Speicher-Snapshot\",\r\n  \"导出内存快照\": \"Speicher-Snapshot exportieren\",\r\n  \"清除异常记录\": \"Ausnahmedatensätze löschen\",\r\n  \"清除记录并关闭\": \"Löschen Sie die Aufzeichnung und schließen Sie sie\",\r\n  \"清除已保存的异常标记；日志和转储文件会保留。\": \"Löscht gespeicherte Ausnahmeflags; Protokolle und Dump-Dateien bleiben erhalten.\",\r\n  \"复制报告\": \"Bericht kopieren\",\r\n  \"关键字\": \"Schlüsselwörter\",\r\n  \"花\": \"Blume\",\r\n  \"第\": \"NEIN.\",\r\n  \"轮 ·\": \"Rad ·\",\r\n  \"导出诊断包\": \"Diagnosepaket exportieren\",\r\n  \"继续使用\": \"weiterhin verwenden\",\r\n  \"诗句记录\": \"Versaufzeichnung\",\r\n  \"人在场\": \"anwesende Personen\",\r\n  \"轮到你了，请输入含有关键字的诗句\": \"Sie sind an der Reihe, bitte geben Sie ein Gedicht mit Schlüsselwörtern ein\",\r\n  \"认输\": \"sich geschlagen geben\",\r\n  \"输入诗句...\": \"Geben Sie ein Gedicht ein...\",\r\n  \"是否猜人物\": \"Ob man den Charakter erraten soll\",\r\n  \"人物类别\": \"Charakterkategorie\",\r\n  \"已提问\": \"Gefragt\",\r\n  \"剩余猜测\": \"verbleibende Vermutungen\",\r\n  \"AI 已想好一位人物，请提出\\\"是/否\\\"问题来缩小范围\": \"Die KI hat einen Charakter im Kopf, bitte stellen Sie eine Ja/Nein-Frage, um ihn einzugrenzen\",\r\n  \"提出一个可以用\\\"是/否\\\"回答的问题\": \"Stellen Sie eine Frage, die mit Ja/Nein beantwortet werden kann\",\r\n  \"问答记录\": \"Frage-und-Antwort-Aufzeichnung\",\r\n  \"提问\": \"Eine Frage stellen\",\r\n  \"猜测\": \"erraten\",\r\n  \"输入人物姓名...\": \"Geben Sie den Namen der Person ein...\",\r\n  \"例如：这位人物是真实存在的历史人物吗？\": \"Zum Beispiel: Handelt es sich bei dieser Figur um eine echte historische Figur?\",\r\n  \"请输入你猜测的人物姓名，确认后将判定胜负\": \"Bitte geben Sie den Namen des Charakters ein, den Sie erraten haben. Der Gewinner wird nach der Bestätigung ermittelt.\",\r\n  \"确认猜测\": \"Vermutung bestätigen\",\r\n  \"返回提问\": \"Zurück zur Frage\",\r\n  \"成语接龙\": \"Redewendung Solitaire\",\r\n  \"轮\": \"Rad\",\r\n  \"当前需接字\": \"Muss jetzt Wörter lernen\",\r\n  \"成语记录\": \"Redewendungsaufzeichnung\",\r\n  \"轮到你了，请输入成语\": \"Sie sind dran, bitte geben Sie eine Redewendung ein\",\r\n  \"触发\": \"auslösen\",\r\n  \"待办\": \"Zu erledigen\",\r\n  \"屏幕软键盘 (F8)\": \"Bildschirmtastatur (F8)\",\r\n  \"输入四字成语...\": \"Geben Sie die vierstellige Redewendung ein...\",\r\n  \"当前会话消费（USD）\": \"Aktueller Sitzungsverbrauch (USD)\",\r\n  \"下载管理（Ctrl+D）\": \"Download-Verwaltung (Strg+D)\",\r\n  \"搜索聊天记录（Ctrl+F）\": \"Chatverlauf durchsuchen (Strg+F)\",\r\n  \"今日预算使用情况\": \"Heutiger Budgetverbrauch\",\r\n  \"语音输入\": \"Spracheingabe\",\r\n  \"画布\": \"Leinwand\",\r\n  \"输入值或公式（如 =SUM(A1:A10)）\": \"Geben Sie einen Wert oder eine Formel ein (z. B. =SUMME(A1:A10))\",\r\n  \"显示终端（Ctrl+T）\": \"Terminal anzeigen (Strg+T)\",\r\n  \"数据表格\": \"Datentabelle\",\r\n  \"扩展\": \"Expandieren\",\r\n  \"搜索历史（Ctrl+F）...\": \"Suchverlauf (Strg+F)...\",\r\n  \"源代码管理\": \"Quellcodeverwaltung\",\r\n  \"沉浸模式\": \"Immersiver Modus\",\r\n  \"重试\": \"Versuchen Sie es erneut\",\r\n  \"显示或收起 AI 侧栏\": \"KI-Seitenleiste ein- oder ausblenden\",\r\n  \"正在启动桌面工作台…\": \"Desktop-Workbench wird gestartet...\",\r\n  \"编程 AI 助手\": \"KI-Assistenten programmieren\",\r\n  \"新建 Code 会话\": \"Erstellen Sie eine neue Codesitzung\",\r\n  \"今日预算\": \"heutiger Haushalt\",\r\n  \"调整 AI 侧栏宽度\": \"Passen Sie die Breite der AI-Seitenleiste an\",\r\n  \"一起完成编程任务\": \"Erledigen Sie gemeinsam Programmieraufgaben\",\r\n  \"AI 对话\": \"KI-Gespräch\",\r\n  \"描述需求，或在编辑器中选中代码。AI 会结合当前工作区帮你修改、测试和审查。\": \"Beschreiben Sie die Anforderungen oder wählen Sie den Code im Editor aus. KI hilft Ihnen beim Überarbeiten, Testen und Überprüfen basierend auf dem aktuellen Arbeitsbereich.\",\r\n  \"AI 修改\": \"KI-Modifikation\",\r\n  \"附带当前编辑器上下文\": \"Wird mit aktuellem Editorkontext geliefert\",\r\n  \"暂无待审阅的修改\": \"Es liegen keine Änderungen vor, die noch überprüft werden müssen\",\r\n  \"描述编程任务… Enter 发送，Shift+Enter 换行\": \"Beschreiben Sie Programmieraufgaben ... Zum Senden die Eingabetaste, zum Umbrechen die Umschalt+Eingabetaste\",\r\n  \"编程任务\": \"Programmieraufgaben\",\r\n  \"使用当前模型与工具\": \"Nutzen Sie aktuelle Modelle und Werkzeuge\",\r\n  \"发送任务\": \"Aufgabe senden\",\r\n  \"停止任务\": \"Aufgabe stoppen\",\r\n  \"搜索 Babe 历史（Ctrl+F）...\": \"Babe-Verlauf durchsuchen (Strg+F)...\",\r\n  \"搜索 Code 历史（Ctrl+F）...\": \"Codeverlauf durchsuchen (Strg+F)...\",\r\n  \"工具授权状态\": \"Werkzeugautorisierungsstatus\",\r\n  \"电脑控制权限检测\": \"Erkennung von Computerkontrollbehörden\",\r\n  \"以下工具在 AI 首次调用时会请求授权；授权后可在此撤销。\": \"Die folgenden Tools fordern beim ersten Aufruf der KI eine Autorisierung an; Die Berechtigung kann hier widerrufen werden.\",\r\n  \"工具组\": \"Werkzeugsatz\",\r\n  \"全部关\": \"Alles aus\",\r\n  \"全部开\": \"Alles offen\",\r\n  \"自动化任务：定时、系统通知或 HTTP 信号触发后，用 DSL 构造提示词并新建一个 Chat 会话发送。\": \"Automatisierte Aufgaben: Nachdem die Zeitmessung, die Systembenachrichtigung oder das HTTP-Signal ausgelöst wurde, verwenden Sie DSL, um Aufforderungswörter zu erstellen und eine neue Chat-Sitzung zum Senden zu erstellen.\",\r\n  \"新建任务\": \"Neue Aufgabe erstellen\",\r\n  \"刷新 MCP 工具\": \"Aktualisieren Sie die MCP-Tools\",\r\n  \"搜索设置、功能或关键词（Ctrl/Cmd+F）\": \"Sucheinstellungen, Funktionen oder Schlüsselwörter (Strg/Befehl+F)\",\r\n  \"字段修改后自动保存\": \"Nach Feldänderung automatisch speichern\",\r\n  \"暂无自动化任务\": \"Derzeit gibt es keine automatisierten Aufgaben\",\r\n  \"设置概览\": \"Übersicht über die Einstellungen\",\r\n  \"设置分类\": \"Kategorien festlegen\",\r\n  \"助手与个性化\": \"Assistenten und Personalisierung\",\r\n  \"模型与智能\": \"Modelle und Intelligenz\",\r\n  \"System One 决策模型\": \"System One-Entscheidungsmodell\",\r\n  \"模型与连接\": \"Modelle und Verbindungen\",\r\n  \"Token 与上下文\": \"Token und Kontext\",\r\n  \"用量与成本\": \"Nutzung und Kosten\",\r\n  \"消费与用量上限\": \"Verbrauchs- und Nutzungsgrenzen\",\r\n  \"字体\": \"Schriftart\",\r\n  \"语音\": \"Stimme\",\r\n  \"输入法\": \"Eingabemethode\",\r\n  \"外观与语言\": \"Aussehen und Sprache\",\r\n  \"语音与输入\": \"Stimme und Eingabe\",\r\n  \"连接与集成\": \"Verbinden und integrieren\",\r\n  \"工具执行权限\": \"Berechtigungen zur Toolausführung\",\r\n  \"自动化与执行\": \"Automatisierung und Ausführung\",\r\n  \"维护\": \"pflegen\",\r\n  \"环境检测\": \"Umwelttests\",\r\n  \"常用设置\": \"Allgemeine Einstellungen\",\r\n  \"系统与安全\": \"Systeme und Sicherheit\",\r\n  \"本机与虚拟机\": \"Native vs. virtuelle Maschine\",\r\n  \"单次请求容量、输出预留、工具加载和历史压缩。\": \"Einzelanforderungskapazität, Ausgabereservierung, Werkzeugladen und Verlaufskomprimierung.\",\r\n  \"限额分别控制什么\": \"Was steuern die Limits?\",\r\n  \"从这里查看配置状态，或搜索具体设置。普通字段修改后自动保存；连接、安装和维护操作使用各页按钮。\": \"Sehen Sie sich hier den Konfigurationsstatus an oder suchen Sie nach bestimmten Einstellungen. Normale Felder werden nach der Änderung automatisch gespeichert; Verwenden Sie die Schaltflächen auf jeder Seite für Anschluss-, Installations- und Wartungsvorgänge.\",\r\n  \"每天累计 Token、生成图片张数、System One 调用次数，以及按价格表估算的日／周／月 LLM 费用。\": \"Die täglich angesammelten Token, die Anzahl der generierten Bilder, die Anzahl der System One-Anrufe und die geschätzten täglichen/wöchentlichen/monatlichen LLM-Gebühren basierend auf der Preisliste.\",\r\n  \"任务目标预算\": \"Missionszielbudget\",\r\n  \"只作用于当前目标任务，在任务界面设置，保留独立的任务范围。\": \"Es wirkt sich nur auf die aktuelle Zielaufgabe aus und wird in der Aufgabenschnittstelle festgelegt, wobei ein unabhängiger Aufgabenbereich erhalten bleibt.\",\r\n  \"调整 Token 分配\": \"Passen Sie die Token-Zuteilung an\",\r\n  \"头像框\": \"Avatar-Rahmen\",\r\n  \"调整累计限额\": \"Passen Sie das kumulative Limit an\",\r\n  \"Babe 头像框\": \"Baby-Avatar-Rahmen\",\r\n  \"Babe 头像\": \"Baby-Avatar\",\r\n  \"给TA起个名字...\": \"Gib ihm einen Namen...\",\r\n  \"手动切换。\": \"Manuelle Umschaltung.\",\r\n  \"会话创建时按下方策略选定一个模型并锁定到该会话，之后不再自动切换（保护提示词缓存）；仅可用\": \"Drücken Sie beim Erstellen einer Sitzung die folgende Strategie, um ein Modell auszuwählen und es für die Sitzung zu sperren. Danach wird nicht mehr automatisch umgeschaltet (Schutz des Prompt-Wort-Cache); nur verfügbar\",\r\n  \"TA 会定时主动找你聊天（应用打开时即生效，无需停留在 Babe 模式）\": \"TA wird die Initiative ergreifen, regelmäßig mit Ihnen zu chatten (dies wird wirksam, wenn die App geöffnet wird, es ist nicht erforderlich, im Babe-Modus zu bleiben).\",\r\n  \"OpenAI Responses（新版）\": \"OpenAI-Antworten (neue Version)\",\r\n  \"OpenCode Go (订阅)\": \"OpenCode Go (Abonnement)\",\r\n  \"System One 决策需先在「决策模型」标签页启用；失败时回退到条目手动值\": \"System One-Entscheidungsfindung muss zuerst auf der Registerkarte „Entscheidungsmodell“ aktiviert werden; Wenn dies fehlschlägt, wird auf den manuellen Wert des Eintrags zurückgegriffen.\",\r\n  \"搜索模型…\": \"Nach Modellen suchen…\",\r\n  \"OpenCode API Key（Zen / Go 通用）\": \"OpenCode-API-Schlüssel (gemeinsam für Zen/Go)\",\r\n  \"OpenAI兼容：标准 chat/completions；OpenAI Responses：新版 /v1/responses；Anthropic兼容：messages API；OpenCode Zen：免费/按量；OpenCode Go：$10/月订阅，按模型自动路由端点\": \"OpenAI-kompatibel: Standard-Chat/-Abschlüsse; OpenAI Responses: neue Version /v1/responses; Anthropic-kompatibel: Nachrichten-API; OpenCode Zen: frei/gemessen; OpenCode Go: Abonnement für 10 $/Monat, automatisches Routing von Endpunkten nach Modell\",\r\n  \"获取。Zen：按量付费，含限时免费模型（可点「生成新 Key」免登录，key=public）；Go：需先在 opencode.ai 订阅后粘贴同一 Key\": \"Erhalten. Zen: Bezahlen nach Bedarf, einschließlich zeitlich begrenzter kostenloser Modelle (Sie können auf „Neuen Schlüssel generieren“ klicken, um eine Anmeldung zu vermeiden, Schlüssel = öffentlich); Los: Sie müssen zuerst opencode.ai abonnieren und dann denselben Schlüssel einfügen\",\r\n  \"校验请求，本应用\": \"Überprüfungsanfrage, diese Anwendung\",\r\n  \"免费模型官方方案说明：\": \"Beschreibung des offiziellen Plans des kostenlosen Modells:\",\r\n  \"OpenCode 官方将限时免费模型的容量保留给官方客户端 —— 官方网关按\": \"OpenCode reserviert offiziell die Kapazität des zeitlich begrenzten kostenlosen Modells für den offiziellen Client – ​​den offiziellen Gateway-Button\",\r\n  \"（可点击右侧按钮代为填入草稿）。\": \"(Sie können auf die Schaltfläche rechts klicken, um den Entwurf in Ihrem Namen auszufüllen.)\",\r\n  \"不会自动替你伪装\": \"Ich werde mich nicht automatisch für dich verkleiden\",\r\n  \"。若想使用免费模型，需你自行在下方「自定义请求头」中添加一条\": \". Wenn Sie das kostenlose Modell verwenden möchten, müssen Sie unten einen benutzerdefinierten Anforderungsheader hinzufügen.\",\r\n  \"该门控属于官方反滥用措施，规则随时可能变化；一旦官方收紧策略，免费模型可能失效、你的账号或 IP 可能被限流。是否添加由你自行决定并承担相应后果。不添加也可正常使用 Zen 付费模型 / Go 订阅模型。\": \"Diese Torkontrolle ist eine offizielle Maßnahme zur Missbrauchsbekämpfung und die Regeln können sich jederzeit ändern; Sobald der Beamte die Richtlinie verschärft, kann das kostenlose Modell ungültig werden und Ihr Konto oder Ihre IP-Adresse werden möglicherweise eingeschränkt. Es liegt an Ihnen, zu entscheiden, ob Sie es hinzufügen und die entsprechenden Konsequenzen tragen. Sie können das Zen-Bezahlmodell/Go-Abonnementmodell normal nutzen, ohne es hinzuzufügen.\",\r\n  \"风险须知：\": \"Risikoinformationen:\",\r\n  \"在自定义请求头中添加官方 UA\": \"Fügen Sie offiziellen UA in benutzerdefinierten Anforderungsheadern hinzu\",\r\n  \"多模态视觉输入 (强制启用)\": \"Multimodale visuelle Eingabe (obligatorisch aktiviert)\",\r\n  \"无法自动识别模型是否支持多模态时（如 llama.cpp 本地模型），可强制开启以允许读取图片直接注入上下文\": \"Wenn es nicht möglich ist, automatisch zu erkennen, ob das Modell Multimodalität unterstützt (wie das lokale Modell llama.cpp), kann das Öffnen erzwungen werden, damit das Bild gelesen und direkt in den Kontext eingefügt werden kann.\",\r\n  \"外置视觉 API（纯文本模型的眼睛）\": \"External Vision API (Augen für Klartextmodelle)\",\r\n  \"当主模型不支持多模态时，通过独立配置的视觉模型描述图片。需在价格表中添加该 VLM 模型方可计入预算。留空禁用。\": \"Wenn das Hauptmodell keine Multimodalität unterstützt, wird das Bild durch ein unabhängig konfiguriertes visuelles Modell beschrieben. Dieses VLM-Modell muss zur Preisliste hinzugefügt werden, um im Budget berücksichtigt zu werden. Zum Deaktivieren leer lassen.\",\r\n  \"复制主 Agent 的 API URL / Key / Provider 设置\": \"Kopieren Sie die API-URL/Schlüssel/Anbieter-Einstellungen des Master-Agenten\",\r\n  \"对齐主 Agent\": \"Master-Agent ausrichten\",\r\n  \"-- 选择模型 --\": \"-- Modell auswählen --\",\r\n  \"档位随当前模型能力动态变化；切换模型后会自动收敛到该模型支持的档位\": \"Der Gang ändert sich dynamisch mit den Fähigkeiten des aktuellen Modells; Nach dem Modellwechsel konvergiert es automatisch zu dem vom Modell unterstützten Gang.\",\r\n  \"模型名，如 gpt-4o-mini / qwen-vl-plus\": \"Modellname, z. B. gpt-4o-mini / qwen-vl-plus\",\r\n  \"推理强度 / 变体\": \"Argumentationsstärke/Variation\",\r\n  \"自动附加 OpenCode 会话头\": \"OpenCode-Sitzungsheader automatisch anhängen\",\r\n  \"自定义请求头 (对所有文本/VLM 请求生效)\": \"Benutzerdefinierte Anforderungsheader (wirksam für alle Text-/VLM-Anfragen)\",\r\n  \"URL 命中 opencode.ai 时自动发送 x-opencode-session/request/project 等身份头（官方 ID 形状：ses_/msg_ + 12 位十六进制 + 14 位 base62；Go 订阅与免费模型池均会校验）。免费模型所需的 User-Agent 不会自动注入——见下方免费模型说明，由你决定是否添加\": \"Wenn die URL auf opencode.ai trifft, werden Identitätsheader wie x-opencode-session/request/project automatisch gesendet (offizielle ID-Form: ses_/msg_ + 12-stelliges Hexadezimal + 14-stelliges Base62; sowohl das Go-Abonnement als auch der kostenlose Modellpool werden überprüft). Der für das kostenlose Modell erforderliche User-Agent wird nicht automatisch eingefügt. Sehen Sie sich die Beschreibung des kostenlosen Modells unten an. Es liegt an Ihnen, ihn hinzuzufügen\",\r\n  \"添加请求头\": \"Anforderungsheader hinzufügen\",\r\n  \"System One 不生成文本，只做「选择 / 打分 / 是否」类快速决策（70–500ms），用于模型池选型、工具选择、命令护栏、游戏决策等。低置信一律回退原有逻辑，不会阻塞主流程。\": \"System One generiert keinen Text, sondern trifft nur schnelle Entscheidungen (70–500 ms), wie z. B. „Auswählen/Scoren/Ob“, die für die Modellpoolauswahl, Werkzeugauswahl, Befehlsleitplanken, Spielentscheidungen usw. verwendet werden. Bei geringem Vertrauen wird immer auf die ursprüngliche Logik zurückgegriffen und der Hauptprozess wird nicht blockiert.\",\r\n  \"OpenCode Zen（免费 System One 1.13）\": \"OpenCode Zen (Kostenloses System One 1.13)\",\r\n  \"自定义头优先级最高，可覆盖自动头（如手动指定 User-Agent）。保存后立即对下次请求生效\": \"Benutzerdefinierte Header haben die höchste Priorität und können automatische Header außer Kraft setzen (z. B. manuelle Angabe von User-Agent). Nach dem Speichern wird es sofort für die nächste Anfrage wirksam.\",\r\n  \"留空使用默认地址\": \"Lassen Sie das Feld leer, um die Standardadresse zu verwenden\",\r\n  \"TypeSafe 直连（自备 Key）\": \"TypeSafe-Direktverbindung (bringen Sie Ihren eigenen Schlüssel mit)\",\r\n  \"Zen 免费可留空（public）；TypeSafe 必填\": \"Zen ist kostenlos und kann leer gelassen werden (öffentlich); TypeSafe ist erforderlich\",\r\n  \"choice/score 低于该置信度 → 回退原有逻辑\": \"Auswahl/Punktzahl ist niedriger als das Konfidenzniveau → Setzen Sie die ursprüngliche Logik zurück\",\r\n  \"默认 jev-1.13-free（Zen）/ jev-latest（TypeSafe）\": \"Standardmäßig jev-1.13-free (Zen)/jev-latest (TypeSafe)\",\r\n  \"危险命令判断等保守场景：概率达到该值才判定为「危险 / 需要确认」\": \"Konservative Szenarien wie gefährliche Befehlsbeurteilung: Erst wenn die Wahrscheinlichkeit diesen Wert erreicht, wird sie als „gefährlich/Bestätigungsbedürftig“ beurteilt.\",\r\n  \"超时 (ms)\": \"Timeout (ms)\",\r\n  \"关闭可避免把邮件内容发送给决策服务（隐私）\": \"Deaktivieren, um das Senden von E-Mail-Inhalten an Entscheidungsdienste zu vermeiden (Datenschutz)\",\r\n  \"Token 分配\": \"Token-Verteilung\",\r\n  \"上下文是单次请求的总容量；输出、工具定义和对话共用这份空间。每日累计用量与美元限额请到「消费与用量上限」。\": \"Der Kontext ist die Gesamtkapazität einer einzelnen Anfrage; Ausgabe, Werkzeugdefinitionen und Konversationen teilen sich diesen Raum. Die täglich akkumulierte Nutzung und das USD-Limit finden Sie unter „Verbrauchs- und Nutzungslimits“.\",\r\n  \"默认模型上下文容量（tokens）\": \"Standardkontextkapazität des Modells (Tokens)\",\r\n  \"模型一次请求能容纳的输入与输出总量。模型池条目可配置各自容量；会话使用自己选中模型的容量。\": \"Die Gesamtmenge an Ein- und Ausgaben, die das Modell in einer Anfrage verarbeiten kann. Modellpooleinträge können mit eigener Kapazität konfiguriert werden; Sitzungen nutzen die Kapazität ihrer eigenen ausgewählten Modelle.\",\r\n  \"单次输出上限（tokens）\": \"Obergrenze für die Einzelausgabe (Tokens)\",\r\n  \"控制每次请求最多生成多少 token，支持时包含思考 token。输出空间会从上下文中预留，实际上限以当前模型容量为准。\": \"Steuert die maximale Anzahl der für jede Anfrage generierten Token, einschließlich Think-Tokens, sofern unterstützt. Der Ausgaberaum wird vom Kontext reserviert und die tatsächliche Obergrenze basiert auf der aktuellen Modellkapazität.\",\r\n  \"按需加载工具\": \"Laden Sie Werkzeuge nach Bedarf\",\r\n  \"自动选择预加载工具（System One 优先）\": \"Automatische Auswahl von Vorspannwerkzeugen (System One bevorzugt)\",\r\n  \"常用工具保持加载，其余工具通过本地搜索补充，内置、MCP 和插件能力均可发现。\": \"Häufig verwendete Tools bleiben geladen, und der Rest wird durch lokale Suchvorgänge ergänzt, die in integrierten, MCP- und Plug-in-Funktionen auffindbar sind.\",\r\n  \"System One 根据任务选择工具；未启用 System One 的工具选择或服务不可用时使用本地候选。与按需加载可同时开启。\": \"System One wählt Werkzeuge entsprechend der Aufgabe aus; Lokale Kandidaten werden verwendet, wenn die System One-fähige Werkzeugauswahl nicht verfügbar ist oder der Dienst nicht verfügbar ist. Kann gleichzeitig mit dem On-Demand-Laden aktiviert werden.\",\r\n  \"属于上下文的一部分，默认最多 4000；小窗口还会按可用输入空间收敛。完整加载模式不使用该上限。\": \"Teil des Kontexts, standardmäßig bis zu 4000; Auch kleine Fenster passen sich dem verfügbaren Eingaberaum an. Im Volllastmodus wird diese Obergrenze nicht verwendet.\",\r\n  \"工具定义占用上限（估算 tokens）\": \"Obergrenze der Werkzeugdefinitionsbelegung (geschätzte Token)\",\r\n  \"管理启用的工具\": \"Verwalten Sie aktivierte Tools\",\r\n  \"上下文压缩\": \"Kontextkomprimierung\",\r\n  \"自动压缩\": \"automatische Komprimierung\",\r\n  \"输入包络（系统提示词 + 工具定义 + 对话 + 输出预留）占上下文窗口的比例\": \"Verhältnis des Eingabeumschlags (Systemaufforderungswörter + Werkzeugdefinitionen + Dialog + Ausgabereservierungen) zum Kontextfenster\",\r\n  \"开始压缩的占用比例\": \"Belegungsverhältnis zum Starten der Komprimierung\",\r\n  \"上下文占用超过阈值时自动压缩（剪枝 + 结构化摘要检查点）\": \"Automatische Komprimierung (Bereinigung + Prüfpunkt für strukturierte Zusammenfassung), wenn die Kontextnutzung den Schwellenwert überschreitet\",\r\n  \"保留最近对话比例\": \"Behalten Sie den Anteil der letzten Gespräche bei\",\r\n  \"摘要重试次数\": \"Zusammenfassungswiederholungen\",\r\n  \"最近对话原样保留的 token 预算（占窗口比例），压缩只动更早的历史\": \"Das Token-Budget (im Verhältnis zum Fenster) der letzten Konversationen bleibt erhalten und durch die Komprimierung wird nur der frühere Verlauf verschoben.\",\r\n  \"单次压缩摘要上限（tokens）\": \"Obergrenze für einen einzelnen Komprimierungs-Digest (Token)\",\r\n  \"摘要未收敛（没有明显缩短）时的额外重试次数\": \"Anzahl zusätzlicher Wiederholungsversuche, wenn der Digest nicht konvergiert (nicht wesentlich verkürzt)\",\r\n  \"单次摘要请求的最大输出 token（八段式结构化检查点）\": \"Maximales Ausgabetoken für eine einzelne Digest-Anfrage (strukturierter Prüfpunkt mit acht Segmenten)\",\r\n  \"立即压缩\": \"Jetzt komprimieren\",\r\n  \"对当前模式会话手动执行一次压缩\": \"Führen Sie manuell eine Komprimierung für die aktuelle Modussitzung durch\",\r\n  \"厂商预设\": \"Werkseinstellung\",\r\n  \"图像尺寸 / 宽高比\": \"Bildgröße/Seitenverhältnis\",\r\n  \"sk-...（本地端点可留空）\": \"sk-... (lokaler Endpunkt kann leer bleiben)\",\r\n  \"选择厂商后自动填充端点与推荐模型，均可手动修改\": \"Nach Auswahl des Herstellers werden die Endpunkte und empfohlenen Modelle automatisch ausgefüllt und können manuell geändert werden.\",\r\n  \"部分模型/端点仅支持 1 张\": \"Einige Modelle/Endpunkte unterstützen nur 1 Bild\",\r\n  \"Gemini/Imagen/Stability 会自动换算为对应的 aspectRatio\": \"Gemini/Imagen/Stability wird automatisch in das entsprechende AspectRatio konvertiert\",\r\n  \"生成数量\": \"Menge generieren\",\r\n  \"高级参数（按厂商生效，留空用默认）\": \"Erweiterte Parameter (gültig laut Hersteller, leer lassen, um Standard zu verwenden)\",\r\n  \"输出格式\": \"Ausgabeformat\",\r\n  \"背景 background\": \"Hintergrundhintergrund\",\r\n  \"质量 quality\": \"Qualitätsqualität\",\r\n  \"负面提示词\": \"negative Stichworte\",\r\n  \"不要出现的元素…\": \"Elemente, die nicht erscheinen sollten...\",\r\n  \"种子 seed\": \"Samen Samen\",\r\n  \"采样步数 steps\": \"Sampling-Schritte Schritte\",\r\n  \"留空随机\": \"Für Zufallsauswahl leer lassen\",\r\n  \"SD 风格端点专用\": \"Endpunktspezifisch im SD-Stil\",\r\n  \"引导系数 guidance\": \"Führungskoeffizient Führung\",\r\n  \"添加水印\": \"Wasserzeichen hinzufügen\",\r\n  \"风格预设 style\": \"Stil voreingestellter Stil\",\r\n  \"火山方舟等端点生效\": \"Endpunkte wie Volcano Ark werden wirksam\",\r\n  \"占位符：{{prompt}} {{model}} {{size}} {{n}} {{seed}} {{negative_prompt}}；响应自动探测\": \"Platzhalter: {{prompt}} {{model}} {{size}} {{n}} {{seed}} {{negative_prompt}}; als Reaktion auf die automatische Erkennung\",\r\n  \"自定义请求体 JSON 模板\": \"Benutzerdefinierte JSON-Vorlage für den Anforderungstext\",\r\n  \"自定义请求头 (生图 API 生效)\": \"Benutzerdefinierter Anforderungsheader (gültig für Rohbild-API)\",\r\n  \"URL 命中 opencode.ai 时同样会自动附加 OpenCode 官方请求头；自定义头优先级最高\": \"Wenn die URL auf opencode.ai trifft, wird auch automatisch der offizielle OpenCode-Anfrageheader angehängt; Der benutzerdefinierte Header hat die höchste Priorität.\",\r\n  \"刷新用量统计\": \"Nutzungsstatistiken aktualisieren\",\r\n  \"累计用量上限\": \"Kumulatives Nutzungslimit\",\r\n  \"每日 LLM Token 用量上限\": \"Tägliches LLM-Token-Nutzungslimit\",\r\n  \"这些是每日累计限额，与单次回复长度无关。0 表示不限制；达到限额后停止相应的新请求。按下方预算时区每天重置。\": \"Hierbei handelt es sich um kumulative Tageslimits, unabhängig von der Länge einer einzelnen Antwort. 0 bedeutet keine Begrenzung; Bei Erreichen des Limits werden entsprechende neue Anfragen gestoppt. Drücken Sie unten auf die Budgetzeitzone, um sie täglich zurückzusetzen.\",\r\n  \"今日已调用: 0\": \"Heute angerufen: 0\",\r\n  \"每日 System One 决策调用上限（0 为不限制）\": \"Tägliches System One-Entscheidungsaufruflimit (0 bedeutet kein Limit)\",\r\n  \"System One 返回选择、评分或判断，按调用次数单独统计，达到后使用本地回退逻辑。\": \"System One gibt eine Auswahl, Bewertung oder Beurteilung zurück, die je nach Anzahl der Anrufe separat gezählt wird, und verwendet bei Erreichen eine lokale Fallback-Logik.\",\r\n  \"Token 限额覆盖文本、外置视觉及压缩摘要；生图和 System One 分别按张数、调用次数统计。API 不返回用量时按文本估算；已发出的请求可能在结束后超过限额。\": \"Das Token-Limit umfasst Text, externe Bilder und komprimierte Zusammenfassungen; Rohbilder und System One werden basierend auf der Anzahl der Bilder bzw. der Anzahl der Aufrufe gezählt. Die API gibt Nutzungsschätzungen nicht als Text zurück. Gestellte Anfragen können nach Abschluss das Limit überschreiten.\",\r\n  \"清零今日用量计数\": \"Löschen Sie die heutige Nutzungsanzahl\",\r\n  \"今日计数管理\": \"Die heutige Grafenverwaltung\",\r\n  \"只清零今日 Token 和图片张数计数；费用历史、日／周／月美元消费不会删除。\": \"Nur der heutige Token- und Bildzähler wird gelöscht; Der Ausgabenverlauf und der tägliche/wöchentliche/monatliche Dollarverbrauch werden nicht gelöscht.\",\r\n  \"刷新预算控制\": \"Aktualisieren Sie die Budgetkontrolle\",\r\n  \"统计周期\": \"statistischer Zeitraum\",\r\n  \"LLM 消费上限（USD）\": \"LLM-Verbrauchslimit (USD)\",\r\n  \"日／周／月限额同时检查，超过任一周期便按下方策略处理。费用按本地价格表估算；未配置价格的模型记录 Token，金额为 0。\": \"Gleichzeitig werden die Tages-/Wochen-/Monatslimits überprüft. Wenn das Limit einen bestimmten Zeitraum überschreitet, wird es gemäß der nachstehenden Richtlinie verarbeitet. Die Kosten werden anhand der örtlichen Preisliste geschätzt; Modelle ohne konfigurierte Preise erfassen Token und der Betrag ist 0.\",\r\n  \"仅提醒，继续请求\": \"Nur zur Erinnerung, bitte weiter anfordern\",\r\n  \"达到上限后停止新请求\": \"Stoppen Sie neue Anfragen, nachdem das Limit erreicht ist\",\r\n  \"为每个模型填写每 1M token 的单价（USD）。分别支持输入、缓存读取（cache read）、输出、缓存写入（cache write）。\\n                  缓存写入仅勾选 \\\"支持\\\" 的模型才会计费（如 Claude 系列）；其他模型即使有 cacheCreation token 也不计费。\\n                  上下文模态框的费用显示依赖此价格表，未填写的模型不显示费用。\": \"Geben Sie für jedes Modell den Stückpreis (USD) pro 1 Mio. Token ein. Unterstützt Eingabe, Cache-Lesen, Ausgabe und Cache-Schreiben.\\n                  Cache-Schreiben wird nur für Modelle in Rechnung gestellt, die „Unterstützung“ markieren (z. B. die Claude-Serie); Andere Modelle werden nicht in Rechnung gestellt, selbst wenn sie über ein CacheCreation-Token verfügen.\\n                  Die Kostenanzeige des kontextuellen Modalfelds basiert auf dieser Preisliste und die Kosten werden für nicht ausgefüllte Modelle nicht angezeigt.\",\r\n  \"界面动效\": \"Schnittstellenanimation\",\r\n  \"主标签页切换动画\": \"Animation zum Wechseln des Home-Tabs\",\r\n  \"模态框动画\": \"Modale Animation\",\r\n  \"关闭后，对话 / 历史 / 设置等主标签页切换不再播放淡入动画\": \"Nach dem Schließen wird die Einblendanimation nicht mehr abgespielt, wenn zwischen Hauptregisterkarten wie Konversation/Verlauf/Einstellungen gewechselt wird.\",\r\n  \"关闭后，所有模态框打开 / 关闭变为瞬时切换（不再渐显渐隐）\": \"Nach dem Schließen wird das Öffnen/Schließen aller Modalboxen zu einem sofortigen Wechsel (kein Ein- und Ausblenden mehr).\",\r\n  \"内置多款自由字体（SIL OFL 开源协议），可按语言分别配置。选择后立即全局生效；保持“系统默认”即维持当前外观。\": \"Mehrere integrierte kostenlose Schriftarten (Open-Source-Protokoll SIL OFL), die separat nach Sprache konfiguriert werden können. Es wird sofort nach der Auswahl global wirksam; Bei Beibehaltung von „System Default“ bleibt das aktuelle Erscheinungsbild erhalten.\",\r\n  \"全局字体\": \"globale Schriftart\",\r\n  \"中文字体（zh）\": \"Chinesische Schriftart (zh)\",\r\n  \"拉丁字形优先使用该字体；未选择时回退到德文字体。\": \"Lateinische Glyphen haben Vorrang vor dieser Schriftart; Fallback auf deutsche Schriftart, wenn nicht ausgewählt.\",\r\n  \"中文字形（含 CJK）使用该字体。\": \"Chinesische Glyphen (einschließlich CJK) verwenden diese Schriftart.\",\r\n  \"英文字体（en）\": \"Englische Schriftart (en)\",\r\n  \"德文字体（de）\": \"Deutsche Schriftart (de)\",\r\n  \"英文字体未选择时，拉丁字形（含德文变音符号 ä ö ü ß）使用该字体。\": \"Wenn die englische Schriftart nicht ausgewählt ist, wird diese Schriftart für lateinische Glyphen (einschließlich deutscher diakritischer Zeichen ä ö ü ß) verwendet.\",\r\n  \"语音模型未就绪\": \"Sprachmodell nicht bereit\",\r\n  \"前往资源下载\": \"Gehen Sie zum Ressourcen-Download\",\r\n  \"请先在「资源下载」中下载语音模型，下载完成前语音设置不可用。\": \"Bitte laden Sie zuerst das Sprachmodell unter „Ressourcen-Download“ herunter. Die Spracheinstellungen sind erst verfügbar, wenn der Download abgeschlossen ist.\",\r\n  \"语音识别\": \"Spracherkennung\",\r\n  \"语音输入（STT）\": \"Spracheingabe (STT)\",\r\n  \"识别模型\": \"Modell identifizieren\",\r\n  \"tiny（更快，省内存）\": \"winzig (schneller, spart Speicher)\",\r\n  \"base（更准，推荐）\": \"Basis (genauer, empfohlen)\",\r\n  \"切换后下次语音识别时生效；主窗口听写与后台唤醒框共用此模型\": \"Es wird wirksam, wenn die Spracherkennung das nächste Mal nach dem Umschalten durchgeführt wird. Das Diktat im Hauptfenster und die Weckbox im Hintergrund teilen sich dieses Modell.\",\r\n  \"发音尾词即发送\": \"Sprechen Sie das letzte Wort aus und senden Sie es\",\r\n  \"例如：发送、发（留空关闭）\": \"Zum Beispiel: senden, senden (zum Schließen leer lassen)\",\r\n  \"语音朗读\": \"Sprachlesung\",\r\n  \"听写结束语包含这些词（逗号分隔）时，自动发送该条消息并去掉关键词\": \"Wenn der Abschluss des Diktats diese Wörter (durch Kommas getrennt) enthält, wird die Nachricht automatisch gesendet und die Schlüsselwörter werden entfernt.\",\r\n  \"语音朗读（TTS）\": \"Vorlesen zur Stimme (TTS)\",\r\n  \"自动朗读 AI 回复\": \"AI-Antworten automatisch vorlesen\",\r\n  \"AI 流式输出时实时朗读，无需等待完成\": \"Die KI liest in Echtzeit, während die Ausgabe gestreamt wird. Sie müssen nicht auf den Abschluss warten\",\r\n  \"中文\": \"chinesisch\",\r\n  \"朗读语言\": \"Sprache lesen\",\r\n  \"中文音色\": \"Chinesisches Timbre\",\r\n  \"自动检测\": \"Automatische Erkennung\",\r\n  \"小北\": \"Xiaobei\",\r\n  \"晓晓 (女声)\": \"Xiaoxiao (weibliche Stimme)\",\r\n  \"小妮\": \"Xiaoni\",\r\n  \"小伊\": \"Xiao Yi\",\r\n  \"云希\": \"Yunxi\",\r\n  \"英文音色\": \"Englisches Timbre\",\r\n  \"云建 (男声)\": \"Yun Jian (männliche Stimme)\",\r\n  \"Heart (美·女声)\": \"Herz (Schönheit · Frauenstimme)\",\r\n  \"Nicole (美·女声)\": \"Nicole (wunderschöne Frauenstimme)\",\r\n  \"Lewis (英·男声)\": \"Lewis (englische männliche Stimme)\",\r\n  \"Bella (美·女声)\": \"Bella (schöne Frauenstimme)\",\r\n  \"Michael (美·男声)\": \"Michael (amerikanische Männerstimme)\",\r\n  \"Emma (英·女声)\": \"Emma (englische Frauenstimme)\",\r\n  \"音量\": \"Volumen\",\r\n  \"语速\": \"Sprechgeschwindigkeit\",\r\n  \"长文本自动切成小块合成，防止单次合成占用过多内存导致 OOM\": \"Langer Text wird für die Synthese automatisch in kleine Stücke zerschnitten, um zu verhindern, dass eine einzelne Synthese zu viel Speicher beansprucht und OOM verursacht\",\r\n  \"长文本自动分块\": \"Teilen Sie langen Text automatisch in Abschnitte auf\",\r\n  \"每块字数\": \"Anzahl der Wörter pro Block\",\r\n  \"120字\": \"120 Wörter\",\r\n  \"后台唤醒\": \"Wachen Sie im Hintergrund auf\",\r\n  \"试听短句\": \"Hören Sie sich kurze Sätze an\",\r\n  \"使用当前音色朗读测试文本\": \"Sprechen Sie den Testtext mit der aktuellen Stimme\",\r\n  \"启用语音唤醒\": \"Aktivieren Sie die Sprachaktivierung\",\r\n  \"唤醒词列表\": \"Weckwortliste\",\r\n  \"常驻麦克风监听，约占用 1~3% CPU\": \"Residente Mikrofonüberwachung, die etwa 1 bis 3 % der CPU beansprucht\",\r\n  \"弹出主窗口\": \"Hauptfenster öffnen\",\r\n  \"弹语音条\": \"Sprachleiste abspielen\",\r\n  \"输入唤醒词…\": \"Weckwort eingeben…\",\r\n  \"添加\": \"Hinzufügen zu\",\r\n  \"全局热键\": \"Globale Hotkeys\",\r\n  \"录制\": \"Aufzeichnen\",\r\n  \"快捷键\": \"Tastenkombination\",\r\n  \"检测灵敏度\": \"Erkennungsempfindlichkeit\",\r\n  \"检查中…\": \"Überprüfung…\",\r\n  \"按此组合键开关听写\": \"Drücken Sie diese Tastenkombination, um das Diktat ein- und auszuschalten\",\r\n  \"模型状态\": \"Modellstatus\",\r\n  \"刷新状态\": \"Aktualisierungsstatus\",\r\n  \"屏幕软键盘 / 输入法\": \"Soft-Tastatur/Eingabemethode auf dem Bildschirm\",\r\n  \"内置屏幕软键盘，支持中文拼音（雾凇拼音词库）与英文/德文输入。\\n                  点击窗口标题栏的键盘图标或按 F8 随时开关。词库由 scripts/build-ime-dicts.js 下载生成。\": \"Die integrierte Bildschirmtastatur unterstützt die Eingabe von Chinesisch Pinyin (Rime Pinyin-Wörterbuch) und Englisch/Deutsch.\\n                  Klicken Sie auf das Tastatursymbol in der Titelleiste des Fensters oder drücken Sie F8, um es jederzeit ein- und auszuschalten. Das Lexikon wird von scripts/build-ime-dicts.js heruntergeladen und generiert.\",\r\n  \"应用启动时自动打开屏幕软键盘\": \"Öffnen Sie automatisch die Bildschirmtastatur, wenn die App gestartet wird\",\r\n  \"关闭后键盘图标/F8 仍可临时打开；开启时应用启动即显示。\": \"Das Tastatursymbol/F8 kann nach dem Schließen noch vorübergehend geöffnet werden; Es wird angezeigt, wenn die Anwendung gestartet wird, wenn sie geöffnet wird.\",\r\n  \"默认输入模式\": \"Standardeingabemodus\",\r\n  \"中文（拼音）\": \"Chinesisch (Pinyin)\",\r\n  \"英文\": \"Englisch\",\r\n  \"德文\": \"Deutsch\",\r\n  \"候选词数量\": \"Anzahl der Kandidatenwörter\",\r\n  \"键盘不透明度\": \"Deckkraft der Tastatur\",\r\n  \"键盘整体透明度，默认不透明。\": \"Die Gesamttransparenz der Tastatur, standardmäßig undurchsichtig.\",\r\n  \"发现新版本\": \"neue Version gefunden\",\r\n  \"自动更新检查发现新版本时提醒（「更新」页可查看详情）\": \"Automatische Update-Prüfung, um Sie zu benachrichtigen, wenn eine neue Version gefunden wird (Details finden Sie auf der Seite „Update“)\",\r\n  \"在需要您干预时发送系统桌面通知（敏感操作审批、会话完成、问卷、文件呈递等）。\\n                  关闭后所有通知都不再弹窗（但 App 内的消息提示仍会显示）。\": \"Senden Sie System-Desktop-Benachrichtigungen, wenn Ihr Eingreifen erforderlich ist (Genehmigung vertraulicher Vorgänge, Abschluss einer Sitzung, Fragebogen, Einreichung von Dateien usw.).\\n                  Nach dem Schließen werden keine Benachrichtigungen mehr angezeigt (die Nachrichtenaufforderungen in der App werden jedoch weiterhin angezeigt).\",\r\n  \"控制白名单\": \"Kontroll-Whitelist\",\r\n  \"仅接受来自下方列表中发件人的邮件控制指令（如审批回复、命令）。其他发件人的邮件将被忽略。\\n                  留空则只接受\\\"用户邮箱地址\\\"的指令（向后兼容旧行为）。\": \"Akzeptieren Sie E-Mail-Kontrollanweisungen (z. B. Genehmigungsantworten, Befehle) nur von den unten aufgeführten Absendern. Nachrichten von anderen Absendern werden ignoriert.\\n                  Lassen Sie das Feld leer, um nur Befehle für „Benutzer-E-Mail-Adresse“ zu akzeptieren (Abwärtskompatibilität mit altem Verhalten).\",\r\n  \"提示：邮箱地址不区分大小写；可添加多个。用户邮箱地址会自动包含在白名单内。\": \"Tipp: Bei E-Mail-Adressen wird die Groß-/Kleinschreibung nicht beachtet. Sie können mehrere hinzufügen. Benutzer-E-Mail-Adressen werden automatisch in die Whitelist aufgenommen.\",\r\n  \"FediKitten 连接\": \"FediKitten-Verbindung\",\r\n  \"连接任意 FediKitten（Mastodon 兼容）实例，让 AI 伙伴可以刷社媒、发帖、私信。登录后 token 会保存在本机，重启后保持登录状态。\": \"Verbinden Sie jede FediKitten-Instanz (Mastodon-kompatibel), um KI-Partnern das Durchsuchen sozialer Medien, das Posten und Senden privater Nachrichten zu ermöglichen. Nach der Anmeldung wird das Token auf dem lokalen Rechner gespeichert und bleibt nach dem Neustart angemeldet.\",\r\n  \"登录后即可让 AI 伙伴使用 FediKitten 能力\": \"Nach der Anmeldung können Sie Ihren KI-Partnern die Nutzung der FediKitten-Funktionen ermöglichen\",\r\n  \"用户名\": \"Benutzername\",\r\n  \"你的用户名\": \"Ihr Benutzername\",\r\n  \"实例地址\": \"Instanzadresse\",\r\n  \"密码\": \"Passwort\",\r\n  \"登录\": \"Einloggen\",\r\n  \"https://fedikitten.pages.dev 或 http://localhost:8787\": \"https://fedikitten.pages.dev oder http://localhost:8787\",\r\n  \"退出\": \"aufhören\",\r\n  \"登录密码（仅用于登录，不会保存）\": \"Login-Passwort (wird nur zur Anmeldung verwendet, wird nicht gespeichert)\",\r\n  \"CIBYP-IM 连接\": \"CIBYP-IM-Verbindung\",\r\n  \"服务器地址\": \"Serveradresse\",\r\n  \"连接 CIBYP-IM 实例（端到端加密即时通讯），让 AI 伙伴可以收发加密消息、管理群聊。密钥保存在本机，重启后保持登录与解密能力。\": \"Stellen Sie eine Verbindung zu einer CIBYP-IM-Instanz (End-to-End-verschlüsseltes Instant Messaging) her, sodass KI-Partner verschlüsselte Nachrichten senden und empfangen und Gruppenchats verwalten können. Der Schlüssel wird lokal gespeichert und die Anmelde- und Entschlüsselungsfunktionen bleiben nach dem Neustart erhalten.\",\r\n  \"登录后即可让 AI 伙伴使用 CIBYP-IM 能力\": \"Melden Sie sich an, um KI-Partnern die Nutzung der CIBYP-IM-Funktionen zu ermöglichen\",\r\n  \"https://cibyp-im.pages.dev 或 http://localhost:8787\": \"https://cibyp-im.pages.dev oder http://localhost:8787\",\r\n  \"主人来信\": \"Brief vom Meister\",\r\n  \"主人用户名\": \"Benutzername des Besitzers\",\r\n  \"接管身份（作废其他设备的加密会话）\": \"Identität übernehmen (verschlüsselte Sitzungen für andere Geräte ungültig machen)\",\r\n  \"无反应\": \"Keine Antwort\",\r\n  \"主人（你）的 IM 用户名，如 admin\": \"IM-Benutzername des Besitzers (Ihnen), z. B. admin\",\r\n  \"创建新 Chat 会话并发送\": \"Erstellen Sie eine neue Chat-Konversation und senden Sie sie\",\r\n  \"收到主人的消息时\": \"Beim Empfang einer Nachricht vom Eigentümer\",\r\n  \"继续当前 Chat 会话（不在 Chat 或空会话则新建）\": \"Setzen Sie die aktuelle Chat-Sitzung fort (erstellen Sie eine neue, wenn sie nicht im Chat ist oder eine leere Sitzung hat)\",\r\n  \"浏览\": \"Durchsuchen\",\r\n  \"配置后，Agent 会定期检查主人发来的私聊消息，并按所选模式处理：先回 IM 确认收到，完成后通过 IM 交付结果（文本 / 文件）。\": \"Nach der Konfiguration überprüft der Agent regelmäßig die vom Eigentümer gesendeten privaten Nachrichten und verarbeitet sie entsprechend dem ausgewählten Modus: Zuerst auf IM antworten, um den Empfang zu bestätigen, und dann nach Abschluss die Ergebnisse (Text/Datei) per IM übermitteln.\",\r\n  \"保存主人设置\": \"Besitzereinstellungen speichern\",\r\n  \"浏览器数据\": \"Browserdaten\",\r\n  \"隔离模式（每次全新，不保留任何数据）\": \"Isolationsmodus (jedes Mal neu, keine Daten bleiben erhalten)\",\r\n  \"数据模式（决定登录态是否保留）\": \"Datenmodus (bestimmt, ob der Anmeldestatus erhalten bleibt)\",\r\n  \"持久化配置（登录一次，长期保留）\": \"Persistente Konfiguration (einmal anmelden, lange beibehalten)\",\r\n  \"复制来源（需先完全退出该浏览器）\": \"Kopieren Sie die Quelle (Sie müssen zuerst den Browser vollständig schließen)\",\r\n  \"系统浏览器副本（导入已有登录态）\": \"Kopie des Systembrowsers (vorhandenen Anmeldestatus importieren)\",\r\n  \"复制配置到 Agent 专用目录\": \"Kopieren Sie die Konfiguration in das agentenspezifische Verzeichnis\",\r\n  \"数据目录：应用数据目录下的\": \"Datenverzeichnis: unter dem Anwendungsdatenverzeichnis\",\r\n  \"有头模式（显示浏览器窗口）\": \"Kopfzeilenmodus (Browserfenster anzeigen)\",\r\n  \"。删除该目录即可重置所有登录态。\": \". Löschen Sie dieses Verzeichnis, um alle Anmeldestatus zurückzusetzen.\",\r\n  \"显示模式\": \"Anzeigemodus\",\r\n  \"显示右上角工作提示横幅\": \"Zeigen Sie das Arbeitstipps-Banner in der oberen rechten Ecke an\",\r\n  \"默认开启有头模式以显示浏览器窗口。关闭后将以无头模式在后台运行（无法看到浏览器）\": \"Der Kopfmodus ist standardmäßig aktiviert, um das Browserfenster anzuzeigen. Wenn es geschlossen ist, läuft es im Hintergrund im Headless-Modus (kein Browser sichtbar).\",\r\n  \"有头模式时在屏幕右上角显示\\\"请勿关闭浏览器\\\"横幅。无头模式始终不显示\": \"Zeigt im Headless-Modus in der oberen rechten Ecke des Bildschirms ein Banner mit der Aufschrift „Browser nicht schließen“ an. Der Headless-Modus wird nie angezeigt\",\r\n  \"监听 127.0.0.1 本地端口，允许外部脚本（curl/网页/其他程序）POST 触发自动化任务。默认禁用：未经你主动开启，服务器不会启动\": \"Hört auf den lokalen Port 127.0.0.1 und ermöglicht externen Skripten (Curl/Webpages/andere Programme) den POST, um automatisierte Aufgaben auszulösen. Standardmäßig deaktiviert: Der Server startet nur, wenn Sie ihn aktiv aktivieren.\",\r\n  \"自动化触发\": \"Automatisierungsauslöser\",\r\n  \"允许无 Token 启动\": \"Start ohne Token zulassen\",\r\n  \"⚠️ 不安全：开启后，不携带 Token 的请求也会被放行（即使已配置 Token 列表），任何本机程序（包括浏览器中的网页）都能直接触发任务。仅在无其他选择时使用\": \"⚠️ Unsicher: Wenn diese Option aktiviert ist, werden Anfragen, die kein Token enthalten, zugelassen (auch wenn eine Token-Liste konfiguriert ist), und jedes native Programm (einschließlich Webseiten im Browser) kann die Aufgabe direkt auslösen. Nur verwenden, wenn es keine anderen Optionen gibt\",\r\n  \"修改后需重启服务器生效（关闭再开启开关）\": \"Nach der Änderung müssen Sie den Server neu starten, damit sie wirksam wird (Schalter aus- und wieder einschalten).\",\r\n  \"Token 列表\": \"Token-Liste\",\r\n  \"添加 Token\": \"Token hinzufügen\",\r\n  \"每个 Token 可独立设置名称、有效期、允许传参与可触发的任务范围。外部调用需携带请求头\": \"Für jeden Token kann der Name, die Gültigkeitsdauer sowie die zulässige Übertragung und Teilnahme am auslösbaren Aufgabenbereich unabhängig festgelegt werden. Externe Anrufe müssen Anforderungsheader übertragen\",\r\n  \"服务器状态\": \"Serverstatus\",\r\n  \"DeepSeek 插件\": \"DeepSeek-Plugin\",\r\n  \"插件目录路径\": \"Plugin-Verzeichnispfad\",\r\n  \"选择\": \"wählen\",\r\n  \"安装\": \"Installieren\",\r\n  \"完全兼容 DeepSeek Harness 插件生态：插件通过 Cordis 内核加载，工具经名称/实现翻译层接入 CIBYP。插件为受信代码，安装后默认禁用，请手动启用。\": \"Vollständig kompatibel mit dem Plug-in-Ökosystem DeepSeek Harness: Plug-ins werden über den Cordis-Kernel geladen und Tools werden über die Namens-/Implementierungsübersetzungsschicht mit CIBYP verbunden. Das Plug-in ist ein vertrauenswürdiger Code und nach der Installation standardmäßig deaktiviert. Bitte aktivieren Sie es manuell.\",\r\n  \"从 npm 安装\": \"Von npm installieren\",\r\n  \"从本地目录安装\": \"Aus lokalem Verzeichnis installieren\",\r\n  \"已安装插件\": \"Plugin installiert\",\r\n  \"从 GitHub 安装\": \"Von GitHub installieren\",\r\n  \"npm 包名\": \"NPM-Paketname\",\r\n  \"最大并发会话数\": \"Maximale Anzahl gleichzeitiger Sitzungen\",\r\n  \"多会话后台执行\": \"Hintergrundausführung in mehreren Sitzungen\",\r\n  \"同时运行的会话数达到上限后，新的消息会进入排队状态。\": \"Nachdem die Anzahl der gleichzeitig ausgeführten Sitzungen die Obergrenze erreicht hat, werden neue Nachrichten in den Warteschlangenstatus aufgenommen.\",\r\n  \"如 C:\\\\Windows\\\\System32\\\\bash.exe 或 /bin/zsh\": \"Zum Beispiel C:\\\\Windows\\\\System32\\\\bash.exe oder /bin/zsh\",\r\n  \"进程沙箱\": \"Prozess-Sandbox\",\r\n  \"默认模式\": \"Standardmodus\",\r\n  \"只读\": \"Nur lesen\",\r\n  \"完全访问（不限制）\": \"Voller Zugriff (keine Einschränkungen)\",\r\n  \"约束 Agent 启动的进程（Shell/Python/Node/终端/FFmpeg）的文件写入范围；网络与进程不受限\": \"Beschränken Sie den Dateischreibbereich der vom Agent gestarteten Prozesse (Shell/Python/Node/Terminal/FFmpeg). Netzwerk und Prozesse werden nicht eingeschränkt\",\r\n  \"工作区可写\": \"Der Arbeitsbereich ist beschreibbar\",\r\n  \"完全访问\": \"voller Zugriff\",\r\n  \"跟随默认\": \"Folgen Sie der Standardeinstellung\",\r\n  \"Chat 模式覆盖\": \"Chat-Modus außer Kraft setzen\",\r\n  \"Babe 模式覆盖\": \"Überschreibung des Babe-Modus\",\r\n  \"Code 模式覆盖\": \"Überschreiben des Codemodus\",\r\n  \"拦截时确认升级\": \"Bestätigen Sie das Upgrade beim Abfangen\",\r\n  \"命令被沙箱拦截或后端不可用时，弹窗确认后以完全权限重试（关闭则直接报错）\": \"Wenn der Befehl von der Sandbox abgefangen wird oder das Backend nicht verfügbar ist, wird ein Popup-Fenster zur Bestätigung und zum erneuten Versuch mit vollständigen Berechtigungen angezeigt (wenn geschlossen, wird ein Fehler direkt gemeldet).\",\r\n  \"后端状态\": \"Backend-Status\",\r\n  \"运行自检\": \"Führen Sie einen Selbsttest durch\",\r\n  \"运行位置\": \"Betriebsposition\",\r\n  \"本机（当前系统）\": \"Diese Maschine (aktuelles System)\",\r\n  \"命令与终端运行在\": \"Befehl und Terminal laufen ein\",\r\n  \"虚拟机（CIBYP-VM-OS）\": \"Virtuelle Maschine (CIBYP-VM-OS)\",\r\n  \"工作区模式\": \"Arbeitsbereichsmodus\",\r\n  \"选择虚拟机后：终端、Shell / Python / Node、文件读写、文档与媒体工具、浏览器自动化全部作用于隔离的 Linux 环境；切换需要重启应用。\": \"Nach Auswahl der virtuellen Maschine funktionieren Terminal, Shell/Python/Node, Lesen und Schreiben von Dateien, Dokument- und Medientools sowie Browserautomatisierung alle in der isolierten Linux-Umgebung. Für den Wechsel ist ein Neustart der Anwendung erforderlich.\",\r\n  \"共享工作区（本机为准 + 双向同步）\": \"Gemeinsamer Arbeitsbereich (lokaler Computer + bidirektionale Synchronisierung)\",\r\n  \"独立工作区（虚拟机内为准）\": \"Unabhängiger Arbeitsbereich (vorbehaltlich innerhalb der virtuellen Maschine)\",\r\n  \"共享：文件留在本机，虚拟机通过\": \"Freigabe: Die Dateien bleiben auf der lokalen Maschine und die virtuelle Maschine wird weitergeleitet\",\r\n  \"双向增量同步；\": \"Zwei-Wege-Inkrementalsynchronisation;\",\r\n  \"重置虚拟机不会丢工作区\": \"Durch das Zurücksetzen einer virtuellen Maschine geht der Arbeitsbereich nicht verloren\",\r\n  \"未同步\": \"Nicht synchronisiert\",\r\n  \"。独立：工作区只在虚拟机内，需要时显式导出（隔离更强）。\": \". Unabhängig: Der Arbeitsbereich befindet sich nur innerhalb der virtuellen Maschine und wird bei Bedarf explizit exportiert (stärkere Isolation).\",\r\n  \"立即同步\": \"Jetzt synchronisieren\",\r\n  \"工作区同步\": \"Synchronisierung des Arbeitsbereichs\",\r\n  \"仅推送\": \"Nur drücken\",\r\n  \"更换目录\": \"Verzeichnis wechseln\",\r\n  \"仅拉回\": \"Nur zurückziehen\",\r\n  \"状态\": \"Zustand\",\r\n  \"虚拟机沙盒（CIBYP-VM-OS）\": \"Sandbox für virtuelle Maschinen (CIBYP-VM-OS)\",\r\n  \"立即重启应用\": \"Starten Sie die App jetzt neu\",\r\n  \"打开 VM 桌面\": \"Öffnen Sie den VM-Desktop\",\r\n  \"资源\": \"Ressource\",\r\n  \"虚拟机文件管理器\": \"Dateimanager für virtuelle Maschinen\",\r\n  \"下载 / 更新\": \"Herunterladen/Aktualisieren\",\r\n  \"镜像变体\": \"Spiegelvariante\",\r\n  \"自检\": \"Selbsttest\",\r\n  \"打开目录\": \"Verzeichnis öffnen\",\r\n  \"重置虚拟机\": \"Virtuelle Maschine zurücksetzen\",\r\n  \"未检测\": \"Nicht erkannt\",\r\n  \"端口预览\": \"Hafenvorschau\",\r\n  \"开启 WHPX 硬件加速\": \"Aktivieren Sie die WHPX-Hardwarebeschleunigung\",\r\n  \"检查 QEMU 运行时、硬件加速（Windows: WHPX / Linux: KVM / macOS: HVF）与镜像完整性；无硬件加速时退化为软件模拟（较慢，需管理员权限开启 WHPX）。\": \"Überprüfen Sie die QEMU-Laufzeit, die Hardwarebeschleunigung (Windows: WHPX / Linux: KVM / macOS: HVF) und die Bildintegrität. Ohne Hardwarebeschleunigung degradiert es zur Softwaresimulation (langsamer, Administratorrechte sind erforderlich, um WHPX zu aktivieren).\",\r\n  \"VM 内端口，如 3000\": \"Interner VM-Port, z. B. 3000\",\r\n  \"未映射端口\": \"Nicht zugeordneter Port\",\r\n  \"映射到本机\": \"Zu lokal zuordnen\",\r\n  \"在虚拟机内下载文件\": \"Laden Sie Dateien innerhalb der virtuellen Maschine herunter\",\r\n  \"在虚拟机里起的开发服务器可通过这里映射到宿主 127.0.0.1，用内置浏览器预览。\": \"Der in der virtuellen Maschine gestartete Entwicklungsserver kann hier dem Host 127.0.0.1 zugeordnet und über den integrierten Browser in der Vorschau angezeigt werden.\",\r\n  \"下载\": \"herunterladen\",\r\n  \"虚拟机内目录\": \"Verzeichnis innerhalb der virtuellen Maschine\",\r\n  \"宿主 aria2 多连接下载后自动送入虚拟机；GitHub 链接可用加速镜像\": \"Die Host-Aria2-Mehrfachverbindung wird nach dem Herunterladen automatisch an die virtuelle Maschine gesendet. Zur Beschleunigung des Images kann der GitHub-Link genutzt werden\",\r\n  \"隐私信息保护\": \"Schutz der Privatsphäre\",\r\n  \"启用隐私信息保护\": \"Aktivieren Sie den Datenschutz\",\r\n  \"启用后，在工具调用过程中自动过滤手机号、证件号、社保号、API Key、SSH 私钥、.env 密钥行、Tor Hidden Service 地址、git key 以及配置文件（json/yaml/config 等）中的密码，防止隐私信息进入 AI 上下文与历史记录。\": \"Nach der Aktivierung werden die Mobiltelefonnummer, die ID-Nummer, die Sozialversicherungsnummer, der API-Schlüssel, der private SSH-Schlüssel, die .env-Schlüsselzeile, die Tor Hidden Service-Adresse, der Git-Schlüssel und die Passwörter in Konfigurationsdateien (json/yaml/config usw.) während des Tool-Aufrufprozesses automatisch gefiltert, um zu verhindern, dass private Informationen in den KI-Kontext und -Verlauf gelangen.\",\r\n  \"工具结果过滤\": \"Tool-Ergebnisfilterung\",\r\n  \"过滤触发器（需开启总开关后生效）\": \"Filterauslöser (muss den Hauptschalter einschalten, um wirksam zu werden)\",\r\n  \"工具返回内容注入 AI 上下文前过滤\": \"Das Tool gibt gefilterte Inhalte zurück, bevor sie in den KI-Kontext eingefügt werden\",\r\n  \"写入上下文时隐藏参数中的密码、Token、密钥\": \"Blenden Sie Passwörter, Token und Schlüssel in Parametern aus, wenn Sie Kontext schreiben\",\r\n  \"工具参数脱敏\": \"Desensibilisierung der Werkzeugparameter\",\r\n  \"终端内容过滤\": \"Filterung von Terminalinhalten\",\r\n  \"终端命令与脚本中的密钥、Token 脱敏\": \"Desensibilisierung von Schlüsseln und Token in Terminalbefehlen und Skripten\",\r\n  \"附件文本过滤\": \"Filterung von Anhangstexten\",\r\n  \"手机号\": \"Telefonnummer\",\r\n  \"上传附件的 OCR/提取文本过滤\": \"OCR-/Textextraktionsfilterung hochgeladener Anhänge\",\r\n  \"过滤内容类别（可单独关闭）\": \"Inhaltskategorien filtern (kann einzeln ausgeschaltet werden)\",\r\n  \"身份证号\": \"ID-Nummer\",\r\n  \"SSH 私钥\": \"Privater SSH-Schlüssel\",\r\n  \"社保号/SSN\": \"Sozialversicherungsnummer/SSN\",\r\n  \".env 密钥\": \".env-Schlüssel\",\r\n  \"配置密码\": \"Passwort konfigurieren\",\r\n  \"Tor 地址/密钥\": \"Tor-Adresse/Schlüssel\",\r\n  \"变换逃逸检测\": \"Escape-Erkennung transformieren\",\r\n  \"后台托盘\": \"Backstage-Tablett\",\r\n  \"启用托盘图标\": \"Taskleistensymbol aktivieren\",\r\n  \"关闭后应用将不在系统托盘显示图标，关闭窗口即退出。\": \"Nach dem Schließen zeigt die Anwendung das Symbol nicht mehr in der Taskleiste an und wird beendet, wenn das Fenster geschlossen wird.\",\r\n  \"测试：隐藏到托盘\": \"Test: Im Fach verstecken\",\r\n  \"关闭窗口时\": \"Beim Schließen des Fensters\",\r\n  \"每次询问\": \"Jedes Mal fragen\",\r\n  \"始终后台运行\": \"Immer im Hintergrund laufen\",\r\n  \"始终直接退出\": \"Immer sofort beenden\",\r\n  \"点击后窗口将立即最小化到托盘，可单击托盘图标恢复。\": \"Das Fenster wird sofort in den Infobereich minimiert. Ein Klick auf das Symbol stellt es wieder her.\",\r\n  \"\\\"每次询问\\\"将在关闭窗口时弹窗询问您的偏好。\\\"始终\\\"选项会记住选择。\": \"„Jedes Mal fragen“ zeigt beim Schließen eine Auswahl. „Immer“ speichert die Auswahl.\",\r\n  \"网络搜索\": \"Websuche\",\r\n  \"默认搜索引擎\": \"Standardsuchmaschine\",\r\n  \"Fusion 同时查询四个引擎、去重并按相关度排序。默认使用免登录 MCP；也可配置自己的 Provider、地址和 Key。免登录服务的可用性和限额由服务方决定。\": \"Fusion fragt vier Suchmaschinen ab, entfernt Duplikate und sortiert nach Relevanz. Standardmäßig wird MCP ohne Anmeldung verwendet. Eigene Anbieter, Endpunkte und Schlüssel sind ebenfalls möglich. Verfügbarkeit und Limits legt der Anbieter fest.\",\r\n  \"地址（留空使用默认）\": \"Adresse (leer für Standard)\",\r\n  \"MCP 工具名（可选）\": \"MCP-Toolname (optional)\",\r\n  \"服务配置\": \"Dienstkonfiguration\",\r\n  \"1. 访问\": \"1. Besuchen\",\r\n  \"2. 添加：\": \"2. Hinzufügen:\",\r\n  \"代理即时生效（无需重启），覆盖：AI/VLM/生图请求、模型列表、网页抓取与 net:* 工具、Playwright 浏览器、aria2 下载、npm/curl 等子进程。DNS/ping/traceroute 等底层探测与 IMAP 收信始终直连。\": \"Proxy-Änderungen gelten sofort für KI/VLM/Bilder, Modelllisten, Webabrufe, net:*-Tools, Playwright, aria2 und Unterprozesse wie npm/curl. DNS/ping/traceroute und IMAP verwenden weiterhin direkte Verbindungen.\",\r\n  \"1. 在 Arduino IDE 中打开导出的\": \"1. In der Arduino IDE die exportierte Datei öffnen\",\r\n  \"2. Tools → Board → esp32 → 选择你的 ESP32 型号（如 ESP32 Dev Module）\": \"2. Tools → Board → esp32 → ESP32-Modell auswählen (z. B. ESP32 Dev Module)\",\r\n  \"3. Tools → Board → Boards Manager → 搜索 \\\"ESP32\\\"\": \"3. Tools → Board → Boards Manager → nach „ESP32“ suchen\",\r\n  \"3. Tools → Port → 选择对应的 COM 端口\": \"3. Tools → Port → passenden COM-Port auswählen\",\r\n  \"下载设置\": \"Download-Einstellungen\",\r\n  \"4. （可选）在代码中修改 WiFi SSID 和密码\": \"4. Optional WiFi-SSID und Passwort im Code ändern\",\r\n  \"5. 点击 Arduino IDE 顶部的 \\\"Upload\\\" 按钮（右箭头图标）\": \"5. Oben in der Arduino IDE auf „Upload“ klicken (Pfeil nach rechts)\",\r\n  \"语音模型体积较大，不再随安装包分发。模型由你手动下载，下载后即时生效、无需重启；下载引擎优先使用内置 aria2（多连接加速），不可用时自动回退普通下载。\": \"Die großen Sprachmodelle sind nicht im Installationspaket enthalten. Laden Sie sie manuell herunter; sie sind ohne Neustart nutzbar. aria2 beschleunigt den Download mit mehreren Verbindungen. Bei Bedarf wird ein normaler Download verwendet.\",\r\n  \"官方源（huggingface.co）\": \"Offizielle Quelle (huggingface.co)\",\r\n  \"CN 镜像（hf-mirror.com，推荐国内网络）\": \"China-Spiegel (hf-mirror.com, für chinesische Netze empfohlen)\",\r\n  \"下载源\": \"Download-Quelle\",\r\n  \"模型下载目录\": \"Modell-Downloadordner\",\r\n  \"选择目录\": \"Ordner auswählen\",\r\n  \"默认：程序数据目录/voice-models\": \"Standard: Programm-Datenordner/voice-models\",\r\n  \"唤醒词 KWS 托管在 GitHub Release，不受镜像选择影响\": \"Das KWS-Aktivierungswortmodell liegt auf GitHub Releases und verwendet keinen Spiegel\",\r\n  \"下载全部必需模型\": \"Alle erforderlichen Modelle herunterladen\",\r\n  \"默认程序数据目录；自定义目录对所有语音模型生效\": \"Standardmäßig Programm-Datenordner; eigene Ordner gelten für alle Sprachmodelle\",\r\n  \"必需模型合计约 440MB（VAD + KWS + Whisper base + Kokoro）\": \"Erforderliche Modelle: insgesamt ca. 440 MB (VAD + KWS + Whisper base + Kokoro)\",\r\n  \"语音模型\": \"Sprachmodelle\",\r\n  \"使用说明\": \"Anleitung\",\r\n  \"正在读取模型状态…\": \"Modellstatus wird gelesen…\",\r\n  \"下载中断可再次点击「下载」，已完成的文件会自动跳过；aria2 支持断点续传。\": \"Nach einer Unterbrechung erneut „Herunterladen“ wählen. Fertige Dateien werden übersprungen; aria2 unterstützt das Fortsetzen.\",\r\n  \"未下载模型时，「语音」设置页不可用，启动时会自动关闭已开启的语音开关，避免运行时报错。\": \"Ohne Modelle sind Spracheinstellungen deaktiviert. Beim Start werden Sprachfunktionen ausgeschaltet, deren Modelle fehlen.\",\r\n  \"模型来源：sherpa-onnx 官方发布（HuggingFace csukuangfj/* / GitHub k2-fsa）。\": \"Modellquelle: offizielle sherpa-onnx-Veröffentlichungen (HuggingFace csukuangfj/* / GitHub k2-fsa).\",\r\n  \"开发环境检测\": \"Entwicklungsumgebung prüfen\",\r\n  \"删除模型只影响当前下载目录中的文件；如果你使用自定义目录，请确保磁盘空间充足。\": \"Das Löschen betrifft nur den aktuellen Downloadordner. Bei einem eigenen Ordner ausreichend freien Speicher sicherstellen.\",\r\n  \"重新检测\": \"Erneut prüfen\",\r\n  \"检测结果\": \"Prüfergebnisse\",\r\n  \"点击“重新检测”开始检测\": \"Zum Starten auf „Erneut prüfen“ klicken\",\r\n  \"自动更新检查\": \"Automatische Updateprüfung\",\r\n  \"检测本机是否已安装 Python、Git，以及 JavaScript 运行时（Node+npm 与 Bun 任选其一）及其版本。检测不到的组件，可以让 Agent 打开一个新 Chat 会话帮你安装。\": \"Prüft Python, Git und die JavaScript-Laufzeit (Node+npm oder Bun) samt Version. Fehlende Komponenten kann der Agent in einem neuen Chat installieren.\",\r\n  \"检查间隔\": \"Prüfintervall\",\r\n  \"自动检查更新\": \"Automatisch nach Updates suchen\",\r\n  \"每 12 小时\": \"Alle 12 Stunden\",\r\n  \"每 6 小时\": \"Alle 6 Stunden\",\r\n  \"启动后延迟检查一次，之后按下方间隔定时检查 GitHub Releases。发现新版本时通过系统通知提醒（可在「通知」中关闭）。检查失败不会打扰你。\": \"Prüft nach dem Start verzögert und anschließend im gewählten Intervall die GitHub Releases. Neue Versionen werden als Systembenachrichtigung angezeigt; deaktivierbar unter „Benachrichtigungen“. Fehlgeschlagene Prüfungen bleiben still.\",\r\n  \"每 24 小时\": \"Alle 24 Stunden\",\r\n  \"更新通道\": \"Updatekanal\",\r\n  \"仅稳定版\": \"Nur stabile Versionen\",\r\n  \"检查更新\": \"Nach Updates suchen\",\r\n  \"全部版本\": \"Alle Versionen\",\r\n  \"尚未检查\": \"Noch nicht geprüft\",\r\n  \"仅稳定版只获取正式发布版本；全部版本同时包含 alpha/beta 等预发布版本。默认仅稳定版。\": \"„Nur stabile Versionen“ berücksichtigt ausschließlich fertige Releases. „Alle Versionen“ umfasst auch Alpha/Beta. Standard: nur stabile Versionen.\",\r\n  \"开发\": \"Entwicklung\",\r\n  \"打开 Releases 页\": \"Releases öffnen\",\r\n  \"立即检查\": \"Jetzt prüfen\",\r\n  \"-内置工具\": \"– integrierte Tools\",\r\n  \"搜索聊天记录...\": \"Chatverlauf durchsuchen…\",\r\n  \"上一个（Shift+Enter）\": \"Vorheriger Treffer (Shift+Enter)\",\r\n  \"关闭（Esc）\": \"Schließen (Esc)\",\r\n  \"收起待办侧栏\": \"Aufgabenleiste einklappen\",\r\n  \"下一个（Enter）\": \"Nächster Treffer (Enter)\",\r\n  \"清除已完成的待办\": \"Erledigte Aufgaben entfernen\",\r\n  \"待办完成进度\": \"Aufgabenfortschritt\",\r\n  \"清除已完成\": \"Erledigte entfernen\",\r\n  \"筛选待办\": \"Aufgaben filtern\",\r\n  \"全部\": \"Alle\",\r\n  \"未完成\": \"Offen\",\r\n  \"已完成\": \"Erledigt\",\r\n  \"新的待办内容\": \"Neue Aufgabe\",\r\n  \"添加一个小目标…\": \"Ein kleines Ziel hinzufügen…\",\r\n  \"添加待办\": \"Aufgabe hinzufügen\",\r\n  \"会话\": \"Unterhaltung\",\r\n  \"工作目录\": \"Arbeitsverzeichnis\",\r\n  \"上下文占用（实时）\": \"Kontextbelegung (live)\",\r\n  \"会话消费\": \"Kosten der Unterhaltung\",\r\n  \"缩小 (Ctrl+-)\": \"Verkleinern (Ctrl+-)\",\r\n  \"任务用时\": \"Aufgabendauer\",\r\n  \"适应窗口 / 100% 切换\": \"An Fenster anpassen / 100 % umschalten\",\r\n  \"打开所在文件夹\": \"Enthaltenden Ordner öffnen\",\r\n  \"下载到本地\": \"Lokal herunterladen\",\r\n  \"放大 (Ctrl+=)\": \"Vergrößern (Ctrl+=)\",\r\n  \"关闭 (Esc)\": \"Schließen (Esc)\",\r\n  \"OpenCode Zen (免费/按量)\": \"OpenCode Zen (kostenlos / nutzungsabhängig)\",\r\n  \"如 Zen 免费 Big Pickle\": \"Z. B. kostenloses Zen Big Pickle\",\r\n  \"留空按接入方式自动（Zen/Go 自动）\": \"Leer für automatische Auswahl je Zugang (Zen/Go automatisch)\",\r\n  \"如 big-pickle / gpt-image / glm-5.3-flash\": \"Z. B. big-pickle / gpt-image / glm-5.3-flash\",\r\n  \"Zen 免费可填 public；其他填对应 Key\": \"Für kostenloses Zen „public“, sonst passenden Schlüssel eintragen\",\r\n  \"默认 131072\": \"Standard: 131072\",\r\n  \"自动 (auto)\": \"Automatisch (auto)\",\r\n  \"关闭 (off)\": \"Aus (off)\",\r\n  \"高 (high)\": \"Hoch (high)\",\r\n  \"低 (low)\": \"Niedrig (low)\",\r\n  \"中 (medium)\": \"Mittel (medium)\",\r\n  \"插件配置\": \"Plugin-Konfiguration\",\r\n  \"以 JSON 编辑插件配置；\": \"Plugin-Konfiguration als JSON bearbeiten;\",\r\n  \"表示使用默认值。保存后重新加载插件并生效。\": \"bedeutet Standardwerte. Nach dem Speichern wird das Plugin neu geladen.\",\r\n  \"插件请求授权\": \"Plugin fordert Berechtigung an\",\r\n  \"允许\": \"Erlauben\",\r\n  \"工具：plugin\": \"Tool: plugin\",\r\n  \"工具授权\": \"Tool-Berechtigung\",\r\n  \"全局策略为「System One 决策」时此项作为回退值\": \"Bei globaler Richtlinie „System One-Entscheidung“ dient diese Einstellung als Rückfallwert\",\r\n  \"授权后将不再每次询问；可随时在设置 → 工具中撤销。\": \"Nach der Freigabe wird nicht erneut gefragt. Unter Einstellungen → Tools jederzeit widerrufbar.\",\r\n  \"仅本次\": \"Nur dieses Mal\",\r\n  \"关闭时后台运行？\": \"Nach dem Schließen im Hintergrund laufen?\",\r\n  \"允许并记住\": \"Erlauben und merken\",\r\n  \"选择\\\"始终\\\"或\\\"不再\\\"后将记住您的偏好，可在设置中修改。\": \"„Immer“ oder „Nicht mehr“ speichert Ihre Präferenz. Sie lässt sich in den Einstellungen ändern.\",\r\n  \"您可以关闭窗口后让应用在后台托盘继续运行（接收通知、邮件审批等），\\n          或直接退出应用。\": \"Nach dem Schließen kann die Anwendung im Infobereich weiterlaufen (Benachrichtigungen, E-Mail-Freigaben usw.) oder vollständig beendet werden.\",\r\n  \"不再后台\": \"Nicht mehr im Hintergrund\",\r\n  \"始终后台\": \"Immer im Hintergrund\",\r\n  \"下载管理\": \"Download-Verwaltung\",\r\n  \"新建终端\": \"Neues Terminal\",\r\n  \"添加下载任务\": \"Download hinzufügen\",\r\n  \"正在连接 aria2...\": \"Verbindung mit aria2 wird hergestellt…\",\r\n  \"下载链接\": \"Download-Link\",\r\n  \"支持 HTTP/HTTPS/FTP/BT/磁力链接，Agent 可异步下载\": \"HTTP/HTTPS/FTP/BT/Magnet-Links unterstützt; der Agent kann asynchron herunterladen\",\r\n  \"HTTP/HTTPS/FTP/磁力链接 URL\": \"HTTP/HTTPS/FTP/Magnet-URL\",\r\n  \"暂无下载任务\": \"Keine Downloads\",\r\n  \"文件名（可选）\": \"Dateiname (optional)\",\r\n  \"保存目录\": \"Zielordner\",\r\n  \"留空则从 URL 提取\": \"Leer lassen, um den Namen aus der URL zu übernehmen\",\r\n  \"添加下载\": \"Download hinzufügen\",\r\n  \"正在加载历史记录\": \"Verlauf wird geladen\",\r\n  \"下载保存目录\": \"Download-Zielordner\",\r\n  \"准备加载…\": \"Laden wird vorbereitet…\",\r\n  \"用户形象\": \"Benutzerprofilbild\",\r\n  \"模型配置\": \"Modellkonfiguration\",\r\n  \"OpenCode Go（订阅）\": \"OpenCode Go (Abonnement)\",\r\n  \"正在分批渲染消息，避免界面卡顿。大历史记录可能需要数秒。\": \"Nachrichten werden in Abschnitten gerendert, damit die Oberfläche flüssig bleibt. Große Verläufe können einige Sekunden dauern.\",\r\n  \"例如 Partner\": \"Z. B. Partner\",\r\n  \"OpenCode 官方将限时免费模型的容量保留给官方客户端（网关按\": \"OpenCode reserviert die Kapazität zeitweise kostenloser Modelle für offizielle Clients (das Gateway prüft\",\r\n  \"生成免登录公共 Key\": \"Öffentlichen Schlüssel ohne Anmeldung erzeugen\",\r\n  \"，如需使用免费模型，请自行决定是否添加该请求头。\": \". Entscheiden Sie selbst, ob Sie diesen Header für kostenlose Modelle hinzufügen möchten.\",\r\n  \"校验）。本应用\": \"). Diese Anwendung\",\r\n  \"public（免登录）\": \"public (ohne Anmeldung)\",\r\n  \"添加官方 User-Agent 请求头\": \"Offiziellen User-Agent-Header hinzufügen\",\r\n  \"虚拟机文件\": \"VM-Dateien\",\r\n  \"上一级\": \"Übergeordneter Ordner\",\r\n  \"该门控属于官方反滥用措施，规则随时可能变化；一旦官方收紧策略，免费模型可能失效，你的账号或 IP 可能被限流。是否添加由你自行决定并承担相应后果；不添加也可正常使用付费模型。\": \"Diese Sperre ist eine offizielle Missbrauchsschutzmaßnahme und kann sich ändern. Kostenlose Modelle können entfallen und Konten oder IP-Adressen begrenzt werden. Das Hinzufügen ist Ihre Entscheidung; kostenpflichtige Modelle funktionieren auch ohne diesen Header.\",\r\n  \"前往\": \"Gehe zu\",\r\n  \"新建文件夹\": \"Neuer Ordner\",\r\n  \"文件夹名称\": \"Ordnername\",\r\n  \"新文件夹名称\": \"Name des neuen Ordners\",\r\n  \"创建\": \"Erstellen\",\r\n  \"当前目录\": \"Aktueller Ordner\",\r\n  \"文件列表\": \"Dateiliste\",\r\n  \"文件名\": \"Dateiname\",\r\n  \"打开\": \"Öffnen\",\r\n  \"打开/导入工程 (cipypcb/kicad_pcb/net/csv)\": \"Projekt öffnen/importieren (cipypcb/kicad_pcb/net/csv)\",\r\n  \"新建工程\": \"Neues Projekt\",\r\n  \"撤销 (Ctrl+Z)\": \"Rückgängig (Ctrl+Z)\",\r\n  \"适应视图 (F)\": \"Ansicht anpassen (F)\",\r\n  \"重做 (Ctrl+Y)\": \"Wiederholen (Ctrl+Y)\",\r\n  \"导出\": \"Exportieren\",\r\n  \"翻面视图 (从底层看) (B)\": \"Ansicht von unten (B)\",\r\n  \"原理图\": \"Schaltplan\",\r\n  \"导出生产文件\": \"Fertigungsdateien exportieren\",\r\n  \"导入网表/其他EDA文件\": \"Netzliste/andere EDA-Dateien importieren\",\r\n  \"命令行 (输入 help 查看命令) — 例: comp add R_0805 R1 20 20\": \"Befehlszeile (help für Befehle) – z. B. comp add R_0805 R1 20 20\",\r\n  \"PCB布局\": \"PCB-Layout\",\r\n  \"3D预览\": \"3D-Vorschau\",\r\n  \"库\": \"Bibliothek\",\r\n  \"检查\": \"Prüfen\",\r\n  \"层\": \"Ebenen\",\r\n  \"属性\": \"Eigenschaften\",\r\n  \"检测到上次未保存的工程\": \"Ungespeichertes Projekt gefunden\",\r\n  \"辅助输入: 标签/丝印文本; IC:left:VCC,D0;right:GND,O0; CONN:针数\": \"Hilfseingabe: Beschriftung/Siebdruck; IC:left:VCC,D0;right:GND,O0; CONN:Pinanzahl\",\r\n  \"Gerber 生产包 (zip)\": \"Gerber-Fertigungspaket (zip)\",\r\n  \"RS-274X + Excellon 钻孔\": \"RS-274X + Excellon-Bohrungen\",\r\n  \"Gerber 到目录\": \"Gerber in Ordner\",\r\n  \"散装文件\": \"Einzeldateien\",\r\n  \"KiCad 网表 (.net)\": \"KiCad-Netzliste (.net)\",\r\n  \"可被 KiCad 7+ 打开\": \"In KiCad 7+ öffnbar\",\r\n  \"S-表达式\": \"S-Ausdrücke\",\r\n  \"BOM 物料清单\": \"BOM-Stückliste\",\r\n  \"CSV 网表\": \"CSV-Netzliste\",\r\n  \"贴片坐标 (PnP)\": \"Bestückungskoordinaten (PnP)\",\r\n  \"矢量图\": \"Vektorgrafik\",\r\n  \"PCB 2D 预览 (SVG)\": \"PCB-2D-Vorschau (SVG)\",\r\n  \"原理图 (SVG)\": \"Schaltplan (SVG)\",\r\n  \"PCB 2D 预览 (PNG)\": \"PCB-2D-Vorschau (PNG)\",\r\n  \"当前视角\": \"Aktuelle Perspektive\",\r\n  \"高清位图\": \"Hochauflösendes Bild\",\r\n  \"3D 渲染图 (PNG)\": \"3D-Rendering (PNG)\",\r\n  \"3D 模型 (OBJ+MTL)\": \"3D-Modell (OBJ+MTL)\",\r\n  \"工程有未保存的更改\": \"Projekt enthält ungespeicherte Änderungen\",\r\n  \"回合:\": \"Runde:\",\r\n  \"可导入 Blender 等\": \"In Blender und andere Programme importierbar\",\r\n  \"是否在关闭前保存当前工程？\": \"Aktuelles Projekt vor dem Schließen speichern?\",\r\n  \"牌堆:\": \"Kartenstapel:\",\r\n  \"阶段:\": \"Phase:\",\r\n  \"准备\": \"Bereit\",\r\n  \"游戏日志\": \"Spielprotokoll\",\r\n  \"出牌\": \"Karte spielen\",\r\n  \"弃牌:\": \"Ablage:\",\r\n  \"手牌: 0\": \"Hand: 0\",\r\n  \"基础信息\": \"Grundinformationen\",\r\n  \"结束出牌\": \"Zug beenden\",\r\n  \"Skill 编辑器\": \"Skill-Editor\",\r\n  \"例如：pdf-processing\": \"Z. B. pdf-processing\",\r\n  \"兼容性\": \"Kompatibilität\",\r\n  \"运行时\": \"Laufzeit\",\r\n  \"描述这个技能做什么，以及什么时候使用\": \"Beschreiben, was dieser Skill tut und wann er eingesetzt wird\",\r\n  \"空格分隔，例如：Bash(git:*) Read\": \"Durch Leerzeichen getrennt, z. B. Bash(git:*) Read\",\r\n  \"例如：Requires Python 3.10+ and git\": \"Z. B. Requires Python 3.10+ and git\",\r\n  \"脚本\": \"Skripte\",\r\n  \"自定义元数据\": \"Eigene Metadaten\",\r\n  \"新建脚本\": \"Neues Skript\",\r\n  \"暂无脚本。添加后可在右侧编辑并运行。\": \"Keine Skripte. Nach dem Hinzufügen rechts bearbeiten und ausführen.\",\r\n  \"导入脚本文件\": \"Skriptdatei importieren\",\r\n  \"读取输出\": \"Ausgabe lesen\",\r\n  \"正在加载编辑器...\": \"Editor wird geladen…\",\r\n  \"运行输出\": \"Ausgabe\",\r\n  \"行 1，列 1\": \"Zeile 1, Spalte 1\",\r\n  \"以本机模式启动（本次）\": \"Dieses Mal im lokalen Modus starten\",\r\n  \"正在启动虚拟机环境\": \"VM-Umgebung wird gestartet\",\r\n  \"玩家\": \"Spieler\",\r\n  \"描述阶段\": \"Beschreibungsphase\",\r\n  \"你的词语\": \"Dein Wort\",\r\n  \"人存活\": \"Spieler übrig\",\r\n  \"用一句话描述你的词...\": \"Beschreibe dein Wort in einem Satz…\",\r\n  \"轮到你描述你的词语了（不能直接说出词语）\": \"Du bist mit der Beschreibung dran (das Wort nicht direkt nennen)\",\r\n  \"发言记录\": \"Redebeiträge\",\r\n  \"请投票选出你认为的卧底\": \"Stimme für den vermuteten Spion ab\",\r\n  \"初始化…\": \"Initialisierung…\",\r\n  \"VM 桌面\": \"VM-Desktop\",\r\n  \"确认投票\": \"Abstimmung bestätigen\",\r\n  \"日志\": \"Protokoll\",\r\n  \"在 VM 内启动 Chromium 并把 CDP 暴露给宿主（Playwright 可接管）\": \"Chromium in der VM starten und CDP für den Host freigeben (Playwright kann übernehmen)\",\r\n  \"关闭窗口\": \"Fenster schließen\",\r\n  \"启动 Chromium\": \"Chromium starten\",\r\n  \"重启图形环境\": \"Grafikumgebung neu starten\",\r\n  \"主机\": \"Host\",\r\n  \"正在准备虚拟机图形环境…\": \"VM-Grafikumgebung wird vorbereitet…\",\r\n  \"虚拟机\": \"Virtuelle Maschine\",\r\n  \"传输到虚拟机\": \"In die VM übertragen\",\r\n  \"传输到主机\": \"Auf den Host übertragen\",\r\n  \"取消传输\": \"Übertragung abbrechen\",\r\n  \"聆听中…\": \"Hört zu…\",\r\n  \"覆盖同名文件\": \"Gleichnamige Dateien überschreiben\",\r\n  \"重新识别\": \"Erneut erkennen\",\r\n  \"打开主窗口\": \"Hauptfenster öffnen\"\r\n});\r\nObject.assign(DE_DICT, {\r\n  \"ui.search.title\": \"Websuche\",\r\n  \"ui.search.help\": \"Fusion fragt alle vier Suchmaschinen ab, entfernt Duplikate und sortiert nach Relevanz. MCP funktioniert ohne Anmeldung. Eigene Anbieter, Endpunkte und Schlüssel sind ebenfalls möglich. Verfügbarkeit und Limits legt der Anbieter fest.\",\r\n  \"ui.search.engine\": \"Standardsuchmaschine\",\r\n  \"ui.search.providerOptions\": \"Dienstkonfiguration\",\r\n  \"ui.search.provider\": \"Anbieter\",\r\n  \"ui.search.endpoint\": \"Endpunkt (leer für Standard)\",\r\n  \"ui.search.mcpTool\": \"MCP-Toolname (optional)\",\r\n  \"ui.cwd.open\": \"Aktuellen Arbeitsbereich öffnen\",\r\n  \"ui.cwd.noDesktop\": \"Kein grafischer Desktop verfügbar; der Dateimanager kann nicht geöffnet werden\",\r\n  \"ui.vmFiles.title\": \"VM-Dateimanager\",\r\n  \"ui.vmFiles.host\": \"Host\",\r\n  \"ui.vmFiles.vm\": \"Virtuelle Maschine\",\r\n  \"ui.vmFiles.go\": \"Gehe zu\",\r\n  \"ui.vmFiles.upload\": \"In die VM übertragen\",\r\n  \"ui.vmFiles.download\": \"Auf den Host übertragen\",\r\n  \"ui.vmFiles.overwrite