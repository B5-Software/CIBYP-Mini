{
  "name": "could-i-be-your-partner",
  "version": "1.9.0-alpha.25",
  "description": "全自动AI Agent，帮助完成一切任务",
  "license": "GPL-3.0-or-later",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/prepare-codeoss.js && node scripts/build-macos-computer.js && node scripts/build-app-bundle.js && electron .",
    "prepare:codeoss": "node scripts/prepare-codeoss.js",
    "test:codeoss": "npm run prepare:codeoss && npm run build-app-bundle && electron tests/integration/codeoss-desktop.cjs",
    "build:computer": "node scripts/build-macos-computer.js",
    "test": "npm run test:unit && npm run test:legacy",
    "build-app-bundle": "node scripts/build-app-bundle.js",
    "build:node-core": "node scripts/sync-remote.cjs --check && node scripts/build-node-core.cjs",
    "test:mini-micro": "node tests/integration/mini-micro.cjs",
    "download-voice-models": "node scripts/download-voice-models.js --voice",
    "download-assets": "node scripts/download-voice-models.js && node scripts/download-ocr-paddle.js",
    "prepare-build-assets": "node scripts/prepare-build-assets.js",
    "test:geogebra": "electron tests/geogebra-offline-smoke-main.js",
    "test:ocr": "electron tests/ocr-engine-smoke-main.js",
    "build": "npm run build-app-bundle && npm run prepare-build-assets && npm run download-assets && node scripts/package.js",
    "build:win:x64": "npm run build-app-bundle && npm run prepare-build-assets && npm run download-assets && node scripts/package.js --win --x64",
    "build:win:arm64": "npm run build-app-bundle && npm run prepare-build-assets && npm run download-assets && node scripts/package.js --win --arm64",
    "build:mac:x64": "npm run build-app-bundle && npm run prepare-build-assets && npm run download-assets && node scripts/package.js --mac --x64",
    "build:mac:arm64": "npm run build-app-bundle && npm run prepare-build-assets && npm run download-assets && node scripts/package.js --mac --arm64",
    "build:linux": "npm run build-app-bundle && npm run prepare-build-assets && npm run download-assets && node scripts/package.js --linux",
    "build:linux:x64": "npm run build-app-bundle && npm run prepare-build-assets && npm run download-assets && node scripts/package.js --linux --x64",
    "build:linux:arm64": "npm run build-app-bundle && npm run prepare-build-assets && npm run download-assets && node scripts/package.js --linux --arm64",
    "build:no-tarot": "node scripts/build-no-tarot.js",
    "build:no-tarot:win": "node scripts/build-no-tarot.js --win",
    "build:no-tarot:mac": "node scripts/build-no-tarot.js --mac",
    "build:no-tarot:linux": "node scripts/build-no-tarot.js --linux",
    "dist": "node scripts/package.js",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "test:unit": "npm run build-app-bundle && node --test tests/unit/*.test.cjs",
    "test:legacy": "node tests/run-tests.js",
    "test:live": "npm run build-app-bundle && node tests/run-tests.js --live",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "test:desktop": "npm run build-app-bundle && electron tests/integration/desktop-smoke.cjs && electron tests/integration/automatic-memory.cjs && electron tests/integration/llm-desktop.cjs && electron tests/integration/startup-gate.cjs && electron tests/integration/startup-gate.cjs --renderer-first && electron tests/integration/startup-gate.cjs --host-fallback && electron tests/integration/tui-desktop-activation.cjs --headless && electron tests/integration/crash-report.cjs && electron tests/integration/vm-file-manager.cjs && electron tests/integration/headless-web.cjs && electron tests/integration/tui-session.cjs && node tests/integration/tui-vmdesk.cjs && node tests/integration/instance-exclusion.cjs && npm run test:tui:tty",
    "test:headless": "npm run build-app-bundle && electron tests/integration/headless-web.cjs",
    "test:babe": "npm run build-app-bundle && electron tests/integration/babe-relationship.cjs",
    "test:tui": "npm run build-app-bundle && electron tests/integration/tui-session.cjs",
    "test:tui:tty": "node --test --test-force-exit tests/integration/tui-tty.test.cjs",
    "format": "prettier --write src/main/core src/main/ds-compat src/agent src/tui src/main/agent-runtime.js src/main/webui-agent-driver.js src/main/ipc src/main/services src/main/settings src/shared/pricing.ts src/renderer/core src/preload/channel-subscriptions.js scripts/build-app-bundle.js scripts/lib scripts/package.js scripts/eb-before-pack.js scripts/eb-after-pack.js tests/unit tests/integration eslint.config.cjs tsconfig.json src/main/vm/{guest-tool-worker,tool-files,tool-location,vm-download-manager,vm-file-dialog,vm-process,plugin-runtime-client,plugin-sdk-files,vm-tool-runtime,vm-tools,vm-theme}.js src/renderer/js/vm-file-dialog.js integrations/codeoss scripts/prepare-codeoss.js tests/fixtures/codeoss packages/npm scripts/prepare-npm.cjs scripts/publish-npm.cjs scripts/test-ds-thirdparty.cjs",
    "format:check": "prettier --check src/main/core src/main/ds-compat src/agent src/tui src/main/agent-runtime.js src/main/webui-agent-driver.js src/main/ipc src/main/services src/main/settings src/shared/pricing.ts src/renderer/core src/preload/channel-subscriptions.js scripts/build-app-bundle.js scripts/lib scripts/package.js scripts/eb-before-pack.js scripts/eb-after-pack.js tests/unit tests/integration eslint.config.cjs tsconfig.json src/main/vm/{guest-tool-worker,tool-files,tool-location,vm-download-manager,vm-file-dialog,vm-process,plugin-runtime-client,plugin-sdk-files,vm-tool-runtime,vm-tools,vm-theme}.js src/renderer/js/vm-file-dialog.js integrations/codeoss scripts/prepare-codeoss.js tests/fixtures/codeoss packages/npm scripts/prepare-npm.cjs scripts/publish-npm.cjs scripts/test-ds-thirdparty.cjs",
    "test:vm-picker": "npm run build-app-bundle && electron tests/integration/vm-file-picker-smoke.cjs",
    "test:codeoss:vm": "npm run prepare:codeoss && electron tests/integration/codeoss-vm.cjs",
    "tui": "node bin/cibyp-tui.js",
    "tui:node": "node bin/cibyp-tui.js",
    "prepare:npm": "node scripts/prepare-npm.cjs",
    "publish:npm": "node scripts/publish-npm.cjs",
    "test:npm": "node --test tests/unit/npm-distribution.test.cjs tests/unit/npm-publication.test.cjs tests/unit/npm-download.test.cjs",
    "webui": "node bin/cibyp-webui.js",
    "test:backend": "npm run build-app-bundle && node --test tests/unit/backend-server.test.cjs && electron tests/integration/shared-backend.cjs",
    "test:ds-thirdparty": "npm run build-app-bundle && node scripts/test-ds-thirdparty.cjs",
    "test:ds-vm": "npm run build-app-bundle && node tests/integration/deepseek-vm.cjs"
  },
  "author": {
    "name": "B5-Software",
    "email": "dev@b5-software.invalid"
  },
  "build": {
    "appId": "org.b5-software.cibyp",
    "productName": "Could I Be Your Partner",
    "files": [
      "bin/**/*",
      "packages/npm/lib/**/*",
      "packages/npm/bin/**/*",
      "packages/npm/package.json",
      "packages/remote/**/*",
      "src/**/*",
      "!src/main/native/**/build{,/**/*}",
      "!src/main/native/**/*.mm",
      "!src/main/native/**/binding.gyp",
      "assets/**/*",
      "!assets/codeoss{,/**/*}",
      "!assets/tor{,/**/*}",
      "integrations/codeoss/runtime-lock.json",
      "integrations/tor/runtime-lock.json",
      "scripts/lib/tor-runtime.cjs",
      "integrations/codeoss/theme.cjs",
      "IoT-Firmware/**/*",
      "package.json",
      "LICENSE",
      "build-info.json",
      ".no-tarot",
      "!**/*.md",
      "!**/*.map",
      "!**/*.ts",
      "!**/assets/voice-models{,/**/*}",
      "!**/assets/geogebra-src{,/**/*}",
      "!**/assets/aria2{,/**/*}",
      "!**/src/renderer/js/app-parts{,/**/*}",
      "!assets/node{,/**/*}"
    ],
    "asarUnpack": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "assets/tor/${os}-${arch}",
        "to": "tor",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/codeoss/${os}-${arch}",
        "to": "codeoss",
        "filter": [
          "app/**/*"
        ]
      },
      {
        "from": "assets/aria2/${os}-${arch}",
        "to": "aria2",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/node/${os}-${arch}",
        "to": "node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/npm/lib/aliases.cjs",
        "to": "cli/aliases.cjs"
      },
      {
        "from": "build/cli",
        "to": "cli",
        "filter": [
          "*.cjs",
          "cibyp",
          "cibyp-tui",
          "cibyp-code",
          "*.cmd",
          "*.ps1",
          "cibyp-webui",
          "cibyp-webui.cmd"
        ]
      }
    ],
    "win": {
      "icon": "assets/icons/icons/icon.ico",
      "extraResources": [
        {
          "from": "assets/sandbox/win",
          "to": "sandbox"
        }
      ],
      "target": [
        {
          "target": "nsis"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "${productName} Setup ${version}-${arch}.${ext}",
      "include": "build/installers/nsis.nsh"
    },
    "mac": {
      "icon": "assets/icons/icons/icon.icns",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "需要访问本地网络以连接 Remote 模式下的远端设备和 WebUI 控制服务。",
        "NSMicrophoneUsageDescription": "需要访问麦克风以提供语音输入与后台唤醒功能。音频仅在本机处理，不会上传或存储。",
        "NSBonjourServices": [
          "_http._tcp",
          "_airplay._tcp",
          "_services._dns-sd._udp",
          "_cibyp._tcp"
        ],
        "NSAppleEventsUsageDescription": "需要发送 AppleEvent 以使用系统无障碍 API 获取 UI 树和自动化操作。",
        "NSAppleMusicUsageDescription": "应用需要控制媒体播放以执行用户指令。"
      },
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        },
        {
          "target": "pkg"
        }
      ]
    },
    "linux": {
      "icon": "assets/icons/icons",
      "maintainer": "B5-Software <b5-software@users.noreply.github.com>",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage"
        },
        {
          "target": "deb"
        }
      ]
    },
    "beforePack": "./scripts/eb-before-pack.js",
    "afterPack": "./scripts/eb-after-pack.js",
    "pkg": {
      "scripts": "installers/pkg-scripts",
      "isRelocatable": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "afterInstall": ".cache/installers/after-install.tpl",
      "afterRemove": ".cache/installers/after-remove.tpl"
    }
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "^5.1.0"
    },
    "semver": "^7.6.3",
    "tmp": "^0.2.4",
    "tar": "^7.5.22",
    "lodash": "^4.17.23",
    "ws": "^8.18.0",
    "form-data": "^4.0.4",
    "qs": "^6.16.0",
    "path-to-regexp": "^8.3.0",
    "picomatch": "^4.0.4",
    "ip-address": "^10.1.0",
    "brace-expansion": "^5.0.9",
    "dompurify": "^3.4.13",
    "@xmldom/xmldom": "^0.8.15",
    "sharp": "^0.35.5",
    "image-size": "^2.0.4",
    "uuid": "^11.1.1",
    "fast-uri": "^3.1.7",
    "deepmerge-ts": "^8.0.0",
    "adm-zip": "$adm-zip",
    "nodemailer": "$nodemailer",
    "js-yaml": "$js-yaml",
    "undici": "$undici",
    "onnxruntime-node": "^1.30.0"
  },
