', pair: 'Pair / edit permissions', id: 'Device ID', add: 'Add tool grant', save: 'Save device', private: 'New credentials can only be recovered during this backend boot. Provision over trusted USB / serial; do not send them to an Agent.', tool: 'Tool name, e.g. gpio_write', resources: 'Resources, e.g. gpio:17 (comma separated)', write: 'Allow writes (approval and lease required)', remove: 'Remove', empty: 'No paired devices', online: 'Online', offline: 'Offline', writable: 'Writable', edit: 'Edit permissions', revoke: 'Revoke device', confirmRevoke: 'Click again to confirm revocation', duplicate: 'Tool names must be unique', saved: 'Saved. Configure the device with a WSS gateway URL and the new credentials.', unavailable: 'This backend does not support Remote devices'},\r\n    terminal: { error: 'Terminal operation failed: {error}' },\r\n    camera: {\r\n      title: 'Take a photo', subtitle: 'Use this device’s camera to add a photo to the conversation',\r\n      device: 'Camera', starting: 'Connecting to the camera…', secure: 'Camera access requires HTTPS or localhost. Use a secure connection first.',\r\n      denied: 'Camera permission was denied. Allow access in browser or system settings and retry.', missing: 'No camera is available.',\r\n      retry: 'Retry', retake: 'Retake', cancel: 'Cancel', use: 'Use photo', capture: 'Capture', switch: 'Switch camera',\r\n    },\r\n    reasoning: {\n  \"summary\": \"Reasoning summary\",\n  \"text\": \"Reasoning\",\n  \"requestSummary\": \"Request reasoning summaries\",\n  \"preserve\": \"Keep encrypted reasoning\",\n  \"summaryHelp\": \"Request readable provider summaries without an extra model call. Turning this off does not eliminate internal reasoning token charges. Compatibility providers may not support this option.\",\n  \"preserveHelp\": \"Off by default. When enabled, encrypted reasoning and signatures are saved with chat records and included in JSON / Markdown exports. When off, these fields are no longer saved or